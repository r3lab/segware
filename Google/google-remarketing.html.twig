{% if googleParameters %}
    <script type="text/javascript">
        var google_tag_params = {
            ecomm_prodid: {{ googleParameters.ecomm_prodid|raw }} ,
            ecomm_pagetype: '{{ googleParameters.ecomm_pagetype|raw }}',
            {% if googleParameters.ecomm_totalvalue %}ecomm_totalvalue: {{ googleParameters.ecomm_totalvalue|raw }} {% endif %}
        };
    </script>

    <script type="text/javascript">
        /* <![CDATA[ */
        var google_conversion_id = {{ googleConversionId }};
        var google_custom_params = window.google_tag_params;
        var google_remarketing_only = true;
        /* ]]> */
    </script>

    <script type="text/javascript" src="//www.googleadservices.com/pagead/conversion.js">
    </script>

    <noscript>
        <div style="display:inline;">
            <img height="1" width="1" style="border-style:none;" alt="" src="//googleads.g.doubleclick.net/pagead/viewthroughconversion/{{ googleConversionId }}/?value=0&amp;guid=ON&amp;script=0&amp;"/>
        </div>
    </noscript>
{% endif %}