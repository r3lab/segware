{% extends "FlexyFtwoStoreBundle:Layout:base.html.twig" %}

{% set images = flexy_ftwo_banner_image_list('home-banner').images %}

{% block content %}
    {% include 'FlexyFtwoStoreBundle:Include/Common:main-banner.html.twig' with {images: images} %}

    {% set filters = {
        useSearchParameters: 'true',
        itemsPerPage: 15,
        sortOrder: 'category-asc',
        showOnlyAvailable: 'false',
        filter: filterString,
        category: {
            referenceCode: 'destaques',
            isShopping: 'true'
        }
    } %}

    {% set result = f2_variant_list(filters) %}

    <section class="{{ images|length == 0 ? "first-page-container" : "" }}">
        <div class="container">
            <div class="row">
                <aside class="col-md-3 sidebar-menu">
                    {% include 'FlexyFtwoStoreBundle:Include:sidebar.html.twig' with {withFilter : true, withProducts: true, listAll: true} %}
                </aside>
                <div class="filter-menu-modal-close hidden-lg hidden-md"></div>

                <div class="col-md-9">
                    {% include 'FlexyFtwoStoreBundle:Include:variant-list-block.html.twig' with {
                        title : 'Destaques',
                        variants: result.pagination
                    } %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}


{% block javascript %}
    {%  include 'FlexyFtwoStoreBundle:Javascript:_sidebar.html.twig' %}
{% endblock %}