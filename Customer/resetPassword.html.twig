{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}
{% block javascriptHead %}
    {% if store.googleReCaptcha.isActive %}
        {{ store.googleReCaptcha.scriptTagHeadV3|raw }}
    {% endif %}
{% endblock %}

{% set title = "Troque sua senha" %}
{% set isLightHeader = true %}

{% block content %}
    {% if error %}
        {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : error, 'error' : true} %}
    {% endif %}
    {% if success is defined and success %}
        {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : ['Senha alterada com sucesso! Clique <a href="' ~  path('flexy_ftwo_store_customer_login') ~ '">aqui</a> para efetuar login.']} %}
    {% endif %}

    <section>
        <div class="second-page-container">
            <div class="container">
                {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [
                    {'title' : title }
                ]} %}
                {% include 'FlexyFtwoStoreBundle:Customer:header.html.twig' with {customer: customer} %}
                <div class="row">
                    <div class="col-md-6 col-sm-8 col-md-offset-3 col-sm-offset-2">
                        <div class="header-for-light">
                            <h1 class="wow fadeInRight animated animated" data-wow-duration="1s" style="visibility: visible;-webkit-animation-duration: 1s; -moz-animation-duration: 1s; animation-duration: 1s;">
                                Trocar <span>senha</span>
                            </h1>
                        </div>

                        <div class="block-form box-border wow fadeInLeft animated" data-wow-duration="1s">
                            <form action="{{ path('flexy_ftwo_store_user_remember_password_reset') }}" method="post">
                                <input type="hidden" name="token" value="{{ app.request.get('token', app.user.confirmationToken) }}">
                                <div class="row">
                                    <div class="col-md-12">
                                         {% if isStrongPasswordMandatory %}
                                            <input type="password" name="password" class="form-control strong-password-validation" placeholder="Digite sua nova senha" required="required"/>

                                            <div id="message-error-invalid-password" class="store-strong-password" style="display: none;"></div>
                                        {% else %}
                                            <input type="password" name="password" class="form-control" placeholder="Digite sua nova senha" required="required"/>
                                        {% endif %}
                                    </div>

                                    <div class="col-md-12">
                                        <input type="password" name="password_repeat" class="form-control" placeholder="Confirme sua nova senha" required="required"/>
                                    </div>

                                    <div class="col-md-12">
                                        <hr>
                                        <input type="submit" value="Trocar senha" class="btn btn-primary">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}