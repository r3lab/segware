{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}
{% block javascriptHead %}
    {% if store.googleReCaptcha.isActive %}
        {{ store.googleReCaptcha.scriptTagHeadV3|raw }}
    {% endif %}
{% endblock %}

{% set title = "Esqueci minha senha" %}

{% block content %}
    {% if error %}
        {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : [error], 'error' : true} %}
    {% endif %}
    <section>
        <div class="second-page-container">
            <div class="container">
                {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [{'title' : title }], isCenterOriented : true} %}

                <div class="row">
                    <div class="col-md-6">
                        <div class="block-form box-border wow fadeInLeft animated" data-wow-duration="1s">
                            <h3> <i class="fa fa-unlock-alt"></i> Esqueceu sua senha?</h3>
                            <form action="{{ path('flexy_ftwo_store_user_remember_password_send_email') }}" method="post">
                                <div class="row">
                                    <div class="col-md-12">
                                        <p>
                                        	Preencha seu e-mail e receba instruções para a criação de uma nova senha.
                                        </p>
                                        <input type="email" name="email" placeholder="Digite seu e-mail" class="form-control" required="required"/>
                                    </div>

                                    <div class="col-md-12">
                                        <hr>
                                        <input type="submit" value="Enviar e-mail" class="btn-default-1">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
