{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% set title = "Entrar" %}

{% block content %}
    {% include 'FlexyFtwoStoreBundle:Include/Page:login.html.twig' %}
{% endblock %}

{% block javascript %}
<script>
	$('.emailInput').on('change', function() {
	var mail = $('.emailInput').val();
	var person = '{"email":'+'"'+mail+'"'+'}';
	$.ajax({
	url: '{{ path('flexy_ftwo_store_customerValidation_validate_email') }}',
	type: 'post',
	dataType: 'json',
		data: person,
		success: function (data) { },
		error: function (data) { alert(data.responseJSON.message); }
	   });
	});

	$("#login-edb").on("click", function(){
		$.ajax({
			url: '{{ path('flexy_ftwo_store_customer_login_db_dfa') }}',
			type: 'post',
			dataType: 'json',
				data: {
					codigoCliente: $("#input-codigo-cliente-edb").val(),
					cpf: $("#input-cpf-edb").val(),
					senha: $("#input-senha-edb").val()
				},
				success: function (data) { 
					$('#input-email-edb').val(data);

					$('#form-login-db').submit();
				},
				error: function (data) { alert(data.responseJSON.msg) }
			});
	});

	</script>
	

{% endblock %}

{% block css %}
    <style type="text/css">
      .g-signin2 > div {
        width: 100% !important;
      }
    </style>
{% endblock %}