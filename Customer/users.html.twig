{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% set title = "Usuários" %}

{% block content %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-user-create-error'), 'error' : true } %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-user-create-success'), 'error' : false } %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-user-update-error'), 'error' : true } %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-user-update-success'), 'error' : false } %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store.customer.user.delete.error'), 'error' : true } %}
    {% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store.customer.user.delete.success'), 'error' : false } %}
    <section>
        <div class="second-page-container">
            <div class="container">
                {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [
                {'title' : title }
                ]} %}
                {% include 'FlexyFtwoStoreBundle:Customer:header.html.twig' with {customer: customer} %}
                <article class="">
                        <ul class="nav nav-pills nav-justified">
                            <li class="active">
                                <a href="#users" data-toggle="tab">Usuário(s)</a>
                            </li>
                        </ul>
                    </article>
                    <div class="tab-content">
                        <div class="row tab-pane active" id="users">
                            <article class="col-md-12">
                                <div class="text-right">
                                    <a href="{{ path('flexy_ftwo_store_customer_user_add') }}" class="btn btn-primary text-right">Adicionar novo usuário</a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                        <tr>
                                            <th>Nome</th>
                                            <th>E-mail</th>
                                            <th>Realizado em</th>
                                            <th>Último login</th>
                                            <th>Status</th>
                                            <th>&nbsp;</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for user in customer.users %}
                                            <tr>
                                                <td>{{  user.master ? customer.responsible : user.name }}</td>
                                                <td>{{  user.email }}</td>
                                                <td>{{  user.createdAt|date("d/m/Y") }}</td>
                                                <td>{{  user.lastLogin ? user.lastLogin|date("d/m/Y") : "--" }}</td>
                                                <td style="font-weight: bold;color: {{  user.enabled ? '#006400' : '#E30808' }}">{{  user.enabled ? "Habilitado" : "Desabilitado" }}</td>
                                                <td class="text-right">
                                                    {% if user.master %}
                                                        <a class="btn btn-mini" href="{{ path('flexy_ftwo_store_user_remember_password_reset') }}" title="Trocar minha senha">
                                                            <i class="fa fa-edit"></i></a>
                                                    {% else %}
                                                        <a class="btn btn-mini" href="{{ path("flexy_ftwo_store_customer_user_delete", {id : user.id}) }}" title="Excluir usuário">
                                                            <i class="fa fa-trash-o"></i></a>
                                                        <a class="btn btn-mini" href="{{ path("flexy_ftwo_store_customer_user_enable", {id : user.id}) }}" title="{{ user.enabled ? 'Desativar usuário' : 'Ativar usuário' }}">
                                                            <i class="fa fa-{{ user.enabled ? 'ban' : 'check' }}"></i></a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{%  endblock %}
