{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% set title = "Senha enviada!" %}

{% block content %}
    <section>
        <div class="second-page-container">
            <div class="container">
                {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [{title : "Esqueci minha senha", url : path("flexy_ftwo_store_user_remember_password")}, {'title' : title }], isCenterOriented : true} %}
                <h1>Lembrete de senha enviado!</h1>
                <br/>
                <p>Você receberá um e-mail com instruções para alterar sua senha, caso não tenha recebido o e-mail, volte a etapa anterior para reenviar.</p>
                <br/>
                <br/>
                <p><a href="{{ path("flexy_ftwo_store_customer_login") }}">&larr; Voltar ao acesso da conta</a></p>
                <br/>
            </div>
        </div>
    </section>
{% endblock %}
