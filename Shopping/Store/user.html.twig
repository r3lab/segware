<div class="form-group">
    <label class="form-label">{{ 'generic.name.label'|trans }}<span class="text-error">*</span></label>
    <div class="">
        <input type="text" class="form-control" required="required" name="userName" id="userName" value="{{ app.request.get('userName', store.user.username) }}">
    </div>
</div>
<div class="form-group">
    <label class="form-label">{{ 'generic.email.label'|trans }}<span class="text-error">*</span></label>
    <div class="">
        <input type="email" class="form-control" required="required"  name="userEmail" id="userEmail" value="{{ app.request.get('userEmail', store.user.email) }}">
    </div>
</div>
    <div class="form-group">
        <label class="form-label">{{ 'generic.password.label'|trans }}<span class="text-error">*</span></label>
        <span class="help">{{ 'generic.password.help'|trans }}</span>
        <div class="">
            <input type="password" class="form-control" required="required" name="userPass" id="userPass" value="">
        </div>
    </div>
<div class="form-group">
    <label class="form-label">{{ 'generic.passwordRepeat.label'|trans }}<span class="text-error">*</span></label>
    <div class="">
        <input type="password" class="form-control" required="required" name="userRepeatPass" id="userRepeatPass" value="">
    </div>
</div>
