{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}
{% set title = "Criar nova lista de presentes" %}
{% block content %}
    <section class="second-page-container">
        <div class="container">
            {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [{'title' : title }]} %}
            <div class="header-for-light">
                <h1 class="wow fadeInRight animated animated" data-wow-duration="1s" style="visibility: visible;-webkit-animation-duration: 1s; -moz-animation-duration: 1s; animation-duration: 1s;">
                    {{ title }}
                </h1>
            </div>
            <div class="row">
                <div class="col-md-12 col-sm-12">
                    <form id="create-gift-list-form" action="{{ path('flexy_ftwo_store_giftList_save') }}" method="post" class="frmcontato">
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" name="event-name" placeholder="Nome do evento" class="form-control error" required>
                            </div>
                            <div class="col-md-5">
                                <input type="text" name="event-date" placeholder="Data do evento" class="form-control flexy-input-date error" required>
                            </div>
                            <div class="col-md-2">
                                <button id="create-gift-list-button" type="submit" class="btn btn-primary">Criar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
