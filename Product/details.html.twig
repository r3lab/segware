 {% extends "FlexyFtwoStoreBundle:Layout:base.html.twig" %}
{% set title = variant %}
{% set dc =  store.shoppingStore ? store.shoppingStore.distributionCenter.referenceCode : null %}
{% set price = flexy_ftwo_product_variant_price(variant , dc) %}
{% set hasStock = flexy_ftwo_variant_has_stock(variant, dc) %}
{% set promotion = flexy_ftwo_variant_promotion_catalog_details(variant, dc) %}
{% set promotionProgressive = f2_variant_promotion_progressive({'variant.referenceCode' : variant.referenceCode, 'shoppingStore.referenceCode' : (shoppingStore)?shoppingStore.referenceCode:null}).ranges %}
{% set comments = flexy_ftwo_product_rating_comment_list(variant.product.id) %}
{% if store.config.displayPrice %}
    {% set maxInstallments = flexy_ftwo_installment_maximum_calculator(promotion ? promotion.finalPrice : price, {'variantReferenceCode': variant.referenceCode}) %}
{% endif %}
{% set installments = flexy_ftwo_installment_calculator(promotion ? promotion.finalPrice : price, {'variantReferenceCode' : variant.referenceCode })|first %}
{% set boletoDiscount = (store.paymentMethod.boleto)?store.paymentMethod.boleto.discount:null %}
{% set kitProducts = flexy_ftwo_product_related_by_kit(variant.product) %}
{% set currentCustomer = flexy_ftwo_current_customer() %}
{% set subscriptionPlans = variant.product.subscriptionPlans %}
{% set customerList = f2_customer_list(
    {
        'page.limit' : 10,
        'search.term' : null,
        'bought.variant.referenceCode' : variant.referenceCode,
        'bought.variant.shoppingStore.referenceCode' : (shoppingStore)?shoppingStore.referenceCode:null,
        'customerType.referenceCodes' : [ 'default.customer' ],
        'customer.attributes' : { 'where-buy' : 'sim' },
        'sort.order' : 'lastBuyers-desc'
    }
) %}

{% block metatag %}
    {% if variant.product.masterImage %}
        <meta property="og:image" content="https:{{ variant.product.masterImage.urlOriginal }}"/>
    {% endif %}
{% endblock %}
{% block content %}
    <section>
        <div class="second-page-container">
            <div class="container">
                {% set path = [] %}
                {% for step in f2_store_create_breadcrumbs({ 'product.referenceCode' : variant.product.referenceCode, 'shoppingStore.referenceCode' : (variant.product.shoppingStore)?variant.product.shoppingStore.referenceCode:null }) %}
                    {% if step.categoryName != "Departamentos" %}
                        {% set path = path|merge([{'url': step.categoryUrl, 'title' : step.categoryName}]) %}
                    {% endif %}
                {% endfor %}

                {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : path|merge([{'title' : variant}])} %}

                <div class="block-product-detail">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                            {# Images Desktop #}
                            <div class="product-main-details-media">
                                <div class="product-media-details product-main-media">
                            	    <div class="product-image product-details-image-zoom">
                                        {# Favoritos #}
                                        <div class="product-favorite">                    
                                            <form action="{{ path("flexy_ftwo_store_wishlist_add") }}" method="post">
                                                <input type="hidden" name="productId" value="{{ variant.product.id }}"/>
                                                <button type="submit" class="wishlist-btn favorite-variant-btn" alt="Ícone para adicionar produto na lista de desejos"><span class="lnr lnr-heart"></span></button>                           
                                            </form>
                                        </div> 
                                        {# Tag Frete grátis #}
                                        {% if infoFreteGratis == "Frete grátis" %}
                                        <div class="frete-gratis">
                                        {{infoFreteGratis}}
                                        </div>
                                        {% endif %}
                                        {# Tag descontos #}
                                        {% if promotion %}
                                        <div class="selo-desconto">
                                        {% set porcentagem = promotion.discountPercent %}
                                        <b>-{{ porcentagem|number_format(0, ',', '.') }}%</b>
                                        </div>
                                        {% endif %}
                                        {# Master image #}
                                	    <img id="{{ variant.product.masterImage ? "product-zoom" : "" }}" src="{{ variant.product.masterImage ? variant.product.masterImage.urlLarge : "https://d8vlg9z1oftyc.cloudfront.net/segware/segware-file-manager/assets/images/placeholder.jpg"}}" data-zoom-image="{{ variant.product.masterImage ? variant.product.masterImage.urlOriginal : flexy_ftwo_resource_url_img("img/product-placeholder.gif") }}" alt="">        
                                    </div>
                                    {# Video #}
                                    <div class="product-video"></div>
                                </div>
                                {#<span style="background: red">{{variant.product}}</span>#}
                                {# Thumbnails #}        
                                
                                {# Set variables align thumbnails #}
                                        {% set qtdImages = 0 %}
                                        {% set qtdVideos = 0 %}
                                        
                                        {% for image in flexy_ftwo_product_image_list(variant.product.id) %}
                                            {% set qtdImages = flexy_ftwo_product_image_list(variant.product.id)|length %}
                                        {% endfor %}
                                        
                                        {% for video in variant.product.videos %}
                                            {% set qtdVideos = variant.product.videos|length %}
                                        {% endfor %}
                                        
                                        {% set alignCarrossel = 0 %}                      
                                        {% if qtdImages >= 3 and qtdVideos == 1 %}
                                            {% set alignCarrossel = 1 %}
                                        {% elseif qtdImages >= 4 and qtdVideos == 0 %}
                                            {% set alignCarrossel = 1 %} 
                                        {% elseif qtdImages <= 3 and qtdVideos == 0 %} 
                                            {% set alignCarrossel = 0 %}
                                        {% elseif qtdImages <= 3 and qtdVideos == 1 %} 
                                            {% set alignCarrossel = 0 %}    
                                        {% else %}  
                                        {% set alignCarrossel = 0 %}
                                        {% endif %} 
                                {% if qtdImages > 0 %}        
                                <div id="gal1" class="product-main-gallery-container">
                                    <div class="product-main-gallery">
                                        <div class="owl-carousel owl-theme thumb-carousel">
                                            {# Loop image #}
                                            {% for image in flexy_ftwo_product_image_list(variant.product.id) %}
                                                <a href="javascript:void(0);" data-image="{{ image.urlLarge }}" data-zoom-image="{{ image.urlOriginal }}" class="{{ alignCarrossel ? 'no-align' : 'align-left' }}">
                                                    <img id="img_{{ loop.index }}" src="{{ image.urlSmall }}" alt="">
                                                </a>
                                            {% endfor %}
                                            {# Loop video #}
                                            {% for video in variant.product.videos %}
                                                <a href="javascript:void(0);" data-video="{{ video.code }}" class="{{ alignCarrossel ? 'no-align' : 'align-left' }}">
                                                    <img src="https://img.youtube.com/vi/{{ video.code }}/0.jpg">
                                                </a>
                                            {% endfor %} 
                                        </div>                  
                                    </div>
                                </div>
                                {% endif %}
                                
                            </div>
                            {# End Imagens #}
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                            <div class="product-detail-section">
                                <h1>{{ variant.product.name }}</h1>
                                <div class="ref-rating row">
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <p class="product-ref">REF.: {{ variant.referenceCode }}</p>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <div class="product-rating">
                                            <p class="product-ref"> Avaliações:</p>
                                            <div class="stars">
                                                {% set rating = flexy_ftwo_product_average_rating(variant.product) %}
                                                {% for i in 5..1 %}
                                                    <span class="star {{ i > rating ? '' : 'active' }}"></span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {% if shoppingStore %}
                                    {% include 'FlexyFtwoStoreBundle:Include/Product:store-info.html.twig' with {shoppingStore: shoppingStore, variant: variant} %}
                                {% endif %}

                                <div class="product-information">
                                    {% if variant.product.descriptionGroup.descriptionOne %}
                                        <p class="description">{{ variant.product.descriptionGroup.descriptionOne|raw }}</p>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="product-details">
                            {% if variant.product.customProductAttributes|length > 0 %}
                                <div class="f2-product-attributes">
                                    <hr/>
                                    {% for customProductAttribute in variant.product.customProductAttributes %}
                                        <div class="f2-product-attribute"
                                             id="f2-product-attribute-{{ customProductAttribute.referenceCode }}">
                                            <label class="control-label"
                                                   for="attributeValues[{{ customProductAttribute.referenceCode }}]">{{ customProductAttribute.name }}
                                                {% if customProductAttribute.required %}
                                                <span class="text-error">*</span>
                                                {% endif %}:</label>
                                            {{ flexy_ftwo_common_attribute_render(
                                                customProductAttribute,
                                                null,
                                                {
                                                    "attr" : {
                                                    "name" : "attributeValues[" ~ customProductAttribute.referenceCode ~ "]",
                                                    "required" : customProductAttribute.isRequired
                                                }
                                                }
                                            ) }}
                                            <span id="helpBlock-{{ customProductAttribute.referenceCode }}"
                                                  class="hidden help-block">{{ 'admin.generic.attribute.form.required'|trans }}</span>
                                        </div>
                                    {% endfor %}
                                    <hr/>
                                </div>
                            {% endif %}
                            </div>
                            
                            <div class="product-detail-section">
                                <div class="product-information">
                                    {% if (store.info.usesMultipleSales is empty and hasStock) or (store.info.usesMultipleSales and hasStock) %}
                                        {% if store.config.displayPrice %}
                                            <p class="price">
                                                {% if promotion %}
                                                    <span class="full-price">de
														<del>R$
															{{ price|number_format(2, ',', '.') }}</del>
														por
														<br></span>
                                                {% endif %}

                                                R$
                                                {{ (promotion ? promotion.finalPrice : price)|number_format(2, ',', '.') }}
                                            </p>
                                        {% endif %}

                                        {% if store.config.displayPrice and ((maxInstallments and store.config.displayPrice) or store.paymentMethod.boleto) %}
                                            <div class="installments">
                                                <div id="installmentDetails" class="float-left">
                                                    {% if maxInstallments.installmentNumber > 0 %}
                                                        {{ maxInstallments.installmentNumber }}x de R$
                                                        {{ maxInstallments.installmentValue|number_format(2, ',', '.') }}
                                                        no cartão
                                                    {% endif %}
                                                </div>

                                                <div class="beauty-select  hidden-xs">
                                                    <a href="javascript:void(0);">ver parcelas
                                                        <i class="fa fa-chevron-down"></i>
                                                    </a>

                                                    <div class="details">


                                                        {% if store.paymentMethod.boleto %}

                                                            <li>
                                                                <strong>Boleto:</strong>
                                                            </li>
                                                            <li id="payment-method-boleto">
                                                                À vista por R$
                                                                {{ ((promotion ? promotion.finalPrice : price)*((100-boletoDiscount)/100))|number_format(2, ',', '.') }}
                                                                {% if boletoDiscount %}
                                                                    <br>
                                                                    <span class="boleto-discount">{{ boletoDiscount }}% de desconto</span>
                                                                {% endif %}
                                                            </li>

                                                            {% if (maxInstallments and store.config.displayPrice  and maxInstallments.installmentNumber > 0) %}
                                                                <li>
                                                                    <hr/>
                                                                </li>
                                                            {% endif %}
                                                        {% endif %}

                                                        {% if (maxInstallments and store.config.displayPrice and maxInstallments.installmentNumber > 0) %}

                                                            <li>
                                                                <strong>Cartão:</strong>
                                                            </li>

                                                            {% for key, installment in installments.no_tax %}
                                                                <li class="number-and-value-installments">{{ key }}
                                                                    x R$
                                                                    {{ installment|number_format(2, ',', '.') }}
                                                                    sem juros
                                                                </li>
                                                            {% endfor %}
                                                            {% for key, installment in installments.tax %}
                                                                <li class="number-and-value-installments">{{ key }}
                                                                    x R$
                                                                    {{ installment|number_format(2, ',', '.') }}
                                                                    com juros
                                                                </li>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                {% if promotionProgressive|length > 0 %}
                                                    <div class="beauty-select">
                                                        <a href="#">preço para quantidades
                                                            <i class="fa fa-chevron-down"></i>
                                                        </a>

                                                        <ul class="details">
                                                            {% for key, range in promotionProgressive %}
                                                                <li>De
                                                                    {{ range.start }}
                                                                    a
                                                                    {{ range.end }}
                                                                    -
                                                                    R${{ range.finalValue|number_format(2, ',', '.') }}
                                                                    por un.
                                                                </li>
                                                            {% endfor %}
                                                        </ul>
                                                    </div>
                                                {% endif %}

                                                {% if subscriptionPlans|length > 0 and not variant.product.isAvailableForBooking %}
                                                    <div class="beauty-select">
                                                        <a href="#">planos de assinatura<i
                                                                    class="fa fa-chevron-down"></i>
                                                        </a>

                                                        <ul class="details">
                                                            {% for subscriptionPlan in subscriptionPlans %}
                                                                <li>
                                                                    <strong>{{ subscriptionPlan.name }}</strong>
                                                                    -
                                                                    {{ subscriptionPlan.getDescription() }}
                                                                    .
                                                                </li>
                                                                <br>
                                                            {% endfor %}
                                                        </ul>
                                                    </div>
                                                {% endif %}
                                                <div class="price-with-boleto-discount">
                                                    {% if boletoDiscount %}
                                                        à vista R$
                                                        {{ ((promotion ? promotion.finalPrice : price)*((100-boletoDiscount)/100))|number_format(2, ',', '.') }}
                                                        <span class="discount">(-{{ boletoDiscount }}%)</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endif %}

                                    {% if not variant.product.isSimple and not variant.product.isConfigurable %}
                                        {% if kitProducts|length > 0 %}
                                            {% include 'FlexyFtwoStoreBundle:Include/Product:grid-closed.html.twig' with {variant: variant} %}
                                        {% else %}
                                            <div class="tamanho">
                                                Selecione uma opção:
                                                <ul>
                                                    {% for productVariant in variant.product.variants %}
                                                        <li class="box-size {{ productVariant.id == variant.id ? 'active' : '' }} {{ flexy_ftwo_variant_has_stock(productVariant, shoppingStore ? shoppingStore.referenceCode : null) ? '' : 'unavailable' }}"
                                                            title="{{ flexy_ftwo_variant_has_stock(productVariant, shoppingStore ? shoppingStore.referenceCode : null) ? '' : 'Indisponível' }}">
                                                            <a href="{{ flexy_ftwo_variant_has_stock(productVariant, shoppingStore ? shoppingStore.referenceCode : null) ? flexy_ftwo_product_url(productVariant, shoppingStore ? shoppingStore.referenceCode : null) : "javascript:void(0);" }}">{{ productVariant.presentation }}</a>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        {% endif %}
                                    {% endif %}

                                    {% set seeAlso = flexy_ftwo_product_related_by_group(variant.product, 'other-colors') %}
                                    {% if seeAlso|length > 0 %}
                                        <div class="opcoes">
                                            <div>Outras cores</div>
                                            <ul>
                                                {% for productRelated in seeAlso %}
                                                    {% set productRelatedHasStock = flexy_ftwo_variant_has_stock(productRelated.variant, shoppingStore ? shoppingStore.referenceCode : null) %}
                                                    <li class="{{ productRelatedHasStock ? '' : 'unavailable' }}" title="{{ productRelatedHasStock ? '' : 'Indisponível' }}">
                                                        <a href="{{ productRelatedHasStock ? flexy_ftwo_product_url(productRelated.variant) : "javascript:void(0);" }}">
                                                            <img src="{{ productRelated.variant.product.masterImage ? productRelated.variant.product.masterImage.urlMedium : 'https://d8vlg9z1oftyc.cloudfront.net/segware/segware-file-manager/assets/images/placeholder.jpg'}}">
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}

                                    {% if variant.product.isConfigurable %}
                                        <div class="panel-group item-configurable" id="accordion" role="tablist" aria-multiselectable="false">
                                            {% for slot in productConfigurableSlots  %}
                                                <div class="panel panel-default">
                                                    <div class="panel-heading" role="tab" id="heading-{{ slot.referenceCode }}">
                                                        <h4 class="panel-title">
                                                            <a class="{{ loop.first ? 'open' : '' }}" role="button" {{ slot.mandatory ? '' : 'style="color: gray;"' }} data-toggle="collapse" data-parent="#accordion" href="#collapse-{{ slot.referenceCode }}" aria-expanded="true" aria-controls="collapse-{{ slot.referenceCode }}">
                                                                {{ slot.name }} {{ slot.mandatory ? '' : ' - Opcional' }}
                                                            </a>
                                                        </h4>
                                                    </div>
                                                    <div id="collapse-{{ slot.referenceCode }}" class="panel-collapse collapse {{ loop.first ? 'in' : '' }}" role="tabpanel" aria-labelledby="heading-{{ slot.referenceCode }}">
                                                        <div class="panel-body">
                                                            {% for configurable in slot.productsConfigurable %}
																{% set productItemHasStock = flexy_ftwo_product_has_stock(configurable.variant.product) %}
                                                                <div class="panel-item-wrapper">
                                                                    <div class="item-img">
                                                                        <img style="{% if not productItemHasStock %} filter: grayscale(100%) {% endif %}" class="media-object img-thumbnail" src="{{ f2_store_image_placeholder_small(configurable.variant.product.masterImage) }}">
                                                                    </div>
                                                                    <div class="item-info">
                                                                        <div class="item-name">
                                                                            <p {% if not productItemHasStock %} style="text-decoration: line-through; color: darkgray;" {% endif %} class="mb-0">
                                                                                {{ configurable.variant.product.name }}
                                                                            </p>
                                                                        </div>
                                                                        <div class="item-price">
                                                                            {% if configurable.price > 0 %}
                                                                            <p>
                                                                                +R$ {{(promotion and promotion.discountPercent ? (configurable.price * (1 - promotion.discountPercent / 100))|number_format(2, ',', '.') : configurable.price|number_format(2, ',', '.'))}}
                                                                            </p>
                                                                            {% endif %}
                                                                        </div>
                                                                    </div>
                                                                    <div class="item-select">
                                                                        {% if configurable.slot.quantitySelectableProducts > 1 %}
                                                                            <input
                                                                                type="checkbox"
                                                                                data-price="{{ configurable.price }}"
                                                                                data-promotion-price="{{ (promotion and promotion.discountPercent ? configurable.price * (1 - promotion.discountPercent / 100) : 0) }}"
                                                                                id="configurableProducts[{{ slot.referenceCode }}]"
                                                                                name="configurableProducts[{{ slot.referenceCode }}]"
                                                                                value="{{ configurable.id }}" {{ configurable.isDefault ? 'checked' : ''}}
                                                                                {% if not productItemHasStock %}disabled{% endif %}
                                                                                onClick="checksLimitSelectedItems('{{ configurable.slot.name }}', '{{ configurable.slot.referenceCode }}', {{ configurable.slot.quantitySelectableProducts }})"
                                                                            >
                                                                        {% else %}
                                                                            <input
                                                                                type="radio"
                                                                                data-price="{{ configurable.price }}"
                                                                                data-promotion-price="{{ (promotion and promotion.discountPercent ? configurable.price * (1 - promotion.discountPercent / 100) : 0) }}"
                                                                                class="radio"
                                                                                id="configurableProducts[{{ slot.referenceCode }}]"
                                                                                name="configurableProducts[{{ slot.referenceCode }}]"
                                                                                value="{{ configurable.id }}" {{ configurable.isDefault ? 'checked' : ''}}
                                                                                {% if not productItemHasStock %}disabled{% endif %}
                                                                            >
                                                                        {% endif %}
                                                                    </div>
                                                                </div>
                                                            {% endfor %}
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <input type="hidden" name="customer" id="customer"
                                           value="{{ app.user.customer }}"/>
                                    {% if app.user.customer or app.user.agent %}
                                        {% if variant.product.isAvailableForBooking %}
                                            <div class="row">
                                                <div class="col-sm-12 col-md-6">
                                                    <label for="initialDateBooking">Dt. Inicio:</label>
                                                    <input type="text" class="form-control" id="initialDateBooking"
                                                           onkeydown="return false"/>
                                                </div>

                                                <div class="col-sm-12 col-md-6">
                                                    <label for="endDateBooking">Dt. Devolução:</label>
                                                    <input type="text" class="form-control" id="endDateBooking"
                                                           onkeydown="return false"/>
                                                </div>
                                            </div>
                                            <br/>
                                        {% endif %}
                                    {% endif %}

                                    {% if (store.info.usesMultipleSales is empty and hasStock) or (store.info.usesMultipleSales and hasStock) %}
                                        
                                        <div class="row">
                                            <div class="shopping-cart-buttons col-xs-12 col-sm-12 col-md-12">
                                                {% if not variant.product.isAvailableForBooking %}
                                                    {% if variant.isFractionalStock %}
                                                    <div class="quantity-wrapper">
                                                        <input type="text" id="quantity" name="quantity"
                                                            class="quantity f2-shipping-estimate-quantity product-quantity "
                                                            min="0.001" value="1.000"
                                                            data-maximum-quantity="{{ variant.stock.hasStockControl ? variant.stock.quantity : '' }}"
                                                            data-stock="{{ variant.stock.hasStockControl ? variant.stock.quantity : '' }}"
                                                            data-product-name="{{ variant.product.name }}">
                                                        <script>
                                                            document.addEventListener('DOMContentLoaded', function() {
                                                                var quantityInput = document.querySelector('#quantity');
                                                                quantityInput.addEventListener('input', function() {
                                                                    this.value = this.value.replace(/,/g, '.');
                                                                });
                                                            });
                                                        </script>
                                                    </div>
                                                    {% else %}
                                                    <div class="quantity-wrapper">
                                                        <input type="number" id="quantity" name="quantity"
                                                            class="quantity f2-shipping-estimate-quantity product-quantity number"
                                                            min="1" value="1"
                                                            data-maximum-quantity="{{ variant.stock.hasStockControl ? variant.stock.quantity : '' }}"
                                                            data-product-name="{{ variant.product.name }}">
                                                            </div>
                                                    {% endif %}
                                                {% endif %}

                                                <div class="buttons-arround">
                                                    {% if variant.product.isAvailableForSale %}
                                                        <button type="button"
                                                                class="btn flexy-add-to-cart-custom main_cart_add btn-light-blue col-md-5 col-sm-5 col-xs-7"
                                                                style="margin-right:10px;"
                                                                data-variant-id="{{ variant.id }}"
                                                                data-product-quantity="#quantity"
                                                                data-distributioncenter="{{ (shoppingStore)?shoppingStore.referenceCode:null }}">
                                                                Comprar
                                                        </button>
                                                        {% if cardSaving and pagarmeActived %}
                                                            <button
                                                                    type="button"
                                                                    class="btn flexy-add-to-cart-fast main_cart_add btn-light-blue col-md-5 col-sm-5 col-xs-7"
                                                                    data-variant-id="{{ variant.id }}"
                                                                    data-product-quantity="#quantity"
                                                                    data-distributioncenter="{{ (shoppingStore) ? shoppingStore.referenceCode : null }}"
                                                                    onclick="sendToCartFast('cart', $(this), {{ variant.id }}, event)">
                                                                    &nbsp;Comprar com 1 clique
                                                            </button>
                                                        {% endif %}
                                                    {% endif %}
                                                    <div id="quote-arround">
                                                        {% if variant.product.isAvailableForQuote %}
                                                            <button type="button" id="quote-add-btn" class="wishlist-btn"
                                                                    data-variant-id="{{ variant.id }}"
                                                                    data-product-quantity="#quantity"
                                                                    data-distributioncenter="{{ (shoppingStore)?shoppingStore.referenceCode:null }}">
                                                                    Adicionar ao orçamento
                                                            </button>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                {% if variant.product.isAvailableForBooking %}
                                                    <button type="button" id="booking-add-btn"
                                                            class="btn flexy-add-to-booking main_cart_add btn-light-blue col-md-5 col-sm-5 col-xs-7"
                                                            data-variant-id="{{ variant.id }}"
                                                            data-product-quantity="#quantity"
                                                            data-distributioncenter="{{ (shoppingStore)?shoppingStore.referenceCode:null }}">
                                                        <i class="fa fa-shopping-cart d_inline_m m_right_9"></i>
                                                        &nbsp;Alugar
                                                    </button>
                                                {% endif %}
                                                
                                            </div>

                                        </div>
                                        
                                        <div class="row">

                                            {#<div class="col-xs-12 col-md-12">
                                                <form action="{{ path("flexy_ftwo_store_wishlist_add") }}"
                                                      method="post">
                                                    <input type="hidden" name="productId"
                                                           value="{{ variant.product.id }}"/>
                                                    <button type="submit" title="Adicionar a lista de desejos"
                                                            class="wishlist-btn">
                                                        <i class="fa fa-heart-o"></i>
                                                        &nbsp;Adicionar à minha lista de desejos
                                                    </button>
                                                </form>
                                            </div>#}
                                            
                                            {% if currentCustomer and currentCustomer.hasGiftList %}
                                                <div class="row">
                                                    <div class="col-xs-12 col-md-12">
