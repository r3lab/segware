            itemsMobile: [479, 2],
            singleItem: false,
            itemsScaleUp: false,
            responsive: true,
            responsiveRefreshRate: 200,
            responsiveBaseWidth: window,
            autoPlay: false,
            autoplayTimeout: 8000,
            autoplayHoverPause: true,
            slideTransition: 'linear',
            stopOnHover: true,
            navigation: true,
            navigationMobile: true,
            dots: false,
            paginaton: true
        });
    </script>

    <script>
        $(document).ready(function () {

            function updateArrows() {
                $('.panel-group .panel-collapse').each(function () {
                    var $collapse = $(this);
                    var $link = $collapse.prev('.panel-heading').find('a');

                    if ($collapse.hasClass('in')) {
                        $link.addClass('open');
                    } else {
                        $link.removeClass('open');
                    }
                });
            }

            // Estado inicial (ESSENCIAL)
            updateArrows();

            // Quando abre
            $('.panel-group').on('shown.bs.collapse', function () {
                updateArrows();
            });

            // Quando fecha
            $('.panel-group').on('hidden.bs.collapse', function () {
                updateArrows();
            });

        });
    </script>
		
