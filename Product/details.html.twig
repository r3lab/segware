        /**
         * Re-calculate installments details list by period
         * @param installments
         */
        function recalculateInstallmentListElement(installments) {
          const installmentDetailsListElement = document.querySelector('.beauty-select .details');
          const numberAndValueInstallments = document.querySelectorAll('.installments .number-and-value-installments');

          numberAndValueInstallments.forEach((item) => {
            item.remove();
          })

          Object.entries(installments.no_tax).forEach(([key, installment]) => {
            if (key > 0) {
              installmentDetailsListElement.insertAdjacentHTML('beforeend',
                  `<li class="number-and-value-installments">${key} x ${this.formatMoney(installment)} sem juros </li>`);
            }
          })
          Object.entries(installments.tax).forEach(([key, installment]) => {
            if (key > 0) {
              installmentDetailsListElement.insertAdjacentHTML('beforeend',
                  `<li class="number-and-value-installments">${key} x ${this.formatMoney(installment)} com juros</li>`);
            }

          })
        }

        /**
         * Convert value (float) to money
         * @param value
         * @returns {*}
         */
        function formatMoney(value) {
          const formatMoney = Intl.NumberFormat('pt-BR', {
            style: 'currency',
            currency: 'BRL'
          })

          return formatMoney.format(value);
        }

        /**
         * Re-calculate installments text by period
         * @param maxInstallments
         */
        function recalculateInstallmentElement(maxInstallments) {
          const installmentElement = document.querySelector('#installmentDetails');
          const newInstallmentElement = document.createElement('div');
          if (maxInstallments.installmentNumber > 0) {
            newInstallmentElement.innerText = `${maxInstallments.installmentNumber}x de ${this.formatMoney(maxInstallments.installmentValue)} no cartão`;
          }
          newInstallmentElement.classList.add('float-left')
          newInstallmentElement.id = 'installmentDetails'

          installmentElement.replaceWith(newInstallmentElement);
        }

        /**
         * Re-calculate boleto discount by period
         * @param boletoDiscount
         * @param price
         * @param promotion
         */
        function recalculateBoletoDiscount(boletoDiscount, price, promotion = null) {
          const priceWithBoletoDiscountElement = document.querySelector('.installments .price-with-boleto-discount');
          const paymentMethodBoletoElement = document.querySelector('.details #payment-method-boleto');

          let priceWithDiscount = price * ((100 - boletoDiscount) / 100)

          priceWithDiscount = promotion ? promotion.finalPrice * ((100 - boletoDiscount) / 100) : priceWithDiscount

          priceWithBoletoDiscountElement.innerHTML = `à vista ${this.formatMoney(priceWithDiscount)}<span class="discount">(-{{ boletoDiscount }}%)</span>`;
          paymentMethodBoletoElement.innerHTML = `À vista por ${this.formatMoney(priceWithDiscount)}`;
        }

	</script>

    {% if variant.product.isConfigurable %}
        <script>
          document.addEventListener("DOMContentLoaded", function() {
            recalculateProductPrice();

		  	document.querySelectorAll("[name^='configurableProducts']").forEach(function(checkbox) {
			  checkbox.addEventListener("click", function() {
				recalculateProductPrice()
			  });
			});

			function recalculateProductPrice() {
			  const selectedConfigurableProducts = document.querySelectorAll("[name^='configurableProducts']:checked");
			  let totalWithpromotion = {{ promotion.finalPrice }};
			  let totalPrice = {{ price }};
			  let finalPrice = {{ (promotion ? promotion.finalPrice : price) }};

			  selectedConfigurableProducts.forEach(function(cb) {
                totalPrice += parseFloat(cb.dataset.price) || 0;
                totalWithpromotion += parseFloat(cb.dataset.promotionPrice) || 0;
                finalPrice += parseFloat(cb.dataset.promotionPrice) || 0;
			  });

              recalculateConfigurableProductPriceElement(totalPrice, totalWithpromotion);
			  recalculateBoletoDiscount({{ boletoDiscount }}, finalPrice);
			  recalculateConfigurableProductInstallments(finalPrice);
			}

            function recalculateConfigurableProductPriceElement(price, promotion = null) {
              const priceElement = document.querySelector('.price');
              priceElement.innerHTML = "";

              promotion && priceElement.insertAdjacentHTML(
                  'afterbegin',
                  `<span class='full-price'>de <del>${this.formatMoney(price)}</del> por <br></span>`
              );

              priceElement.insertAdjacentText('beforeend', this.formatMoney(promotion ? promotion : price))
            }

			async function recalculateConfigurableProductInstallments(totalPrice) {
			  let form = new FormData();
			  form.append('variantId', {{ variant.id }});
			  form.append('totalPrice', totalPrice);

			  const { installments, maxInstallments } = await fetch(`{{ path('flexy_ftwo_store_product_calculate_installments_for_configurable_product') }}`, {
				method: "POST",
				body: form
			  }).then(response => {
				if (response.ok) {
				  return response.json().then(data => {
					return data;
				  });
				}
				throw response;
			  }).catch(exception => {
				console.log(exception)
			  })

			  recalculateInstallmentElement(maxInstallments);
			  recalculateInstallmentListElement(installments);
		  	}

			function checksLimitSelectedItems(slotName, slotReferenceCode, quantitySelectableProducts) {
			  let totalSelected = document.querySelectorAll(`input[name="configurableProducts[${slotReferenceCode}]"]:checked`).length;

			  if (totalSelected > quantitySelectableProducts) {
				alert(`Você só pode selecionar até ${quantitySelectableProducts} itens para ${slotName}`);
				event.target.checked = false;
			  }
			}
          });
        </script>
    {% endif %}

    {% if variant.product.isAvailableForBooking %}
        <script src="{{ flexy_ftwo_resource_url_js('js/litepicker.js') }}"></script>
        <script>
            const datePickerOptions = JSON.parse(`{{ bookingDataPickerOptions | json_encode | raw }}`);
            const beginDateBooking = document.getElementById('initialDateBooking');
            const endDateBooking = document.getElementById('endDateBooking');
            const btnBookingAdd = document.querySelector('#booking-add-btn')

            let datePicker = new Litepicker({
                element: beginDateBooking,
                elementEnd: endDateBooking,
                numberOfMonths: 2,
                numberOfColumns: 2,
                resetButton: true,
                selectForward: true,
                singleMode: false,
                tooltipText: {
                    one: 'dia',
                    other: 'dias'
                },
                tooltipNumber: (totalDays) => {
                    return totalDays;
                },
                ...datePickerOptions,
                setup: (picker) => {
                    picker.on('selected', async (beginDate, endDate) => {
                        let beginDateFormated = beginDate.format('YYYY-MM-DD');
                        let endDateFormated = endDate.format('YYYY-MM-DD');

                        await this.calculatePriceByPeriodSelected("{{ variant.id }}", beginDateFormated, endDateFormated)

                        btnBookingAdd.setAttribute('data-product-begindatebooking', beginDateFormated);
                        btnBookingAdd.setAttribute('data-product-enddatebooking', endDateFormated)
                    });
                }
            })

            /**
             * Prepare calendar with unavailable dates
             * @returns {Promise<void>}
             */
            async function prepareDateRange() {
                try {
                    this.toggleBookingDates(beginDateBooking, endDateBooking, true);

                    const datesUnavailable = await this.calculateUnavailableDates({{ variant.id }});
                    datePicker.setLockDays(datesUnavailable);
                } catch (exception) {
                    console.log(exception)
                } finally {
                    this.toggleBookingDates(beginDateBooking, endDateBooking, false)
                }
            }

            /**
             * Request platform to get unavailable dates for variant
             * @param variantId
             * @returns {Promise<Response>}
             */
            async function calculateUnavailableDates(variantId) {
                const result = await fetch(`{{ path('flexy_ftwo_store_booking_unavailable_dates') }}?variantId=${variantId}`).then(response => {
                    if (response.ok) {
                        return response.json().then(data => {
                            return data;
                        });
                    }
                    throw response;
                }).catch(response => {
                    console.log(response)
                });
                return result;
            }

            /**
             * Re-calculate prices by period
             * @param $variantId
             * @param $beginDate
             * @param $endDate
             * @returns {Promise<void>}
             */
            async function calculatePriceByPeriodSelected($variantId, $beginDate, $endDate) {
                let form = new FormData();
                form.append('variantId', $variantId);
                form.append('beginDate', $beginDate);
                form.append('endDate', $endDate);

                this.loadingBookingButton(true);

                const {
                    price,
                    promotion,
                    maxInstallments,
                    installments
                } = await fetch(`{{ path('flexy_ftwo_store_booking_calculate_price_by_period') }}`, {
                    method: "POST",
                    body: form
                }).then(response => {
                    if (response.ok) {
                        return response.json().then(data => {
                            return data;
                        });
                    }
                    throw response;
                }).catch(exception => {
                    console.log(exception)
                }).finally(() => {
                    this.loadingBookingButton(false);
                })

                this.recalculatePriceElement(price, promotion);
                this.recalculateInstallmentElement(maxInstallments);
                {% if boletoDiscount %}
                this.recalculateBoletoDiscount({{ boletoDiscount }}, price, promotion);
                {% endif %}

                this.recalculateInstallmentListElement(installments);
            }

            /**
             * Disable or enable date inputs for booking
             * @param beginElement
             * @param endElement
             * @param isDisabled
             */
            function toggleBookingDates(beginElement, endElement, isDisabled = false) {
                beginElement.disabled = isDisabled
                endElement.disabled = isDisabled
            }

            /**
             * Change button options when date selected
             * @param isLoading
             */
            function loadingBookingButton(isLoading) {
                btnBookingAdd.textContent = isLoading ? 'Carregando...' : 'Alugar'
                btnBookingAdd.disabled = isLoading;
            }

            /**
             * Re-calculate original price by period
             * @param price
             * @param promotion
             */
            function recalculatePriceElement(price, promotion = null) {
                const priceElement = document.querySelector('.price');
                priceElement.innerHTML = "";

                promotion && priceElement.insertAdjacentHTML(
                    'afterbegin',
                    `<span class='full-price'>de <del>${this.formatMoney(promotion.originalPrice)}</del> por <br></span>`
                );

                priceElement.insertAdjacentText('beforeend', this.formatMoney(promotion ? promotion.finalPrice : price))
            }

            this.prepareDateRange();
        </script>
    {% endif %}
    <script>
        window.addEventListener("pageshow", function() {
