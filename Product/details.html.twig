    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const quantityInputs = document.querySelectorAll('.quantity');

            quantityInputs.forEach(input => {
                const isFractional = input.getAttribute('min') === "0.001";

                const decrementButton = document.createElement('button');
                decrementButton.textContent = '-';
                decrementButton.className = 'quantity-decrement';

                const incrementButton = document.createElement('button');
                incrementButton.textContent = '+';
                incrementButton.className = 'quantity-increment';

                input.parentElement.insertBefore(decrementButton, input);
                input.parentElement.insertBefore(incrementButton, input.nextSibling);

                function showStockMessage() {
                    const productName = input.getAttribute('data-product-name') || "Produto";
                    const max = input.getAttribute('data-maximum-quantity') || "0";

                    alert(`O produto ${productName} não possui estoque suficiente. Atualmente possuímos somente ${max}.`);
                }

                decrementButton.addEventListener('click', function (e) {
                    e.preventDefault();
                    let currentValue = parseFloat(input.value) || 0;
                    const min = parseFloat(input.getAttribute('min')) || 0;
                    const step = isFractional ? 0.001 : 1;

                    currentValue = Math.max(currentValue - step, min);
                    input.value = currentValue.toFixed(isFractional ? 3 : 0);
                    input.dispatchEvent(new Event('input'));
                });

                incrementButton.addEventListener('click', function (e) {
                    e.preventDefault();

                    let currentValue = parseFloat(input.value) || 0;
                    const max = parseFloat(input.getAttribute('data-maximum-quantity')) || Infinity;
                    const step = isFractional ? 0.001 : 1;

                    if (currentValue + step > max) {
                        showStockMessage();
                        return;
                    }

                    currentValue += step;
                    input.value = currentValue.toFixed(isFractional ? 3 : 0);
                    input.dispatchEvent(new Event('input'));
                });

                input.addEventListener('blur', function () {
                    let value = parseFloat(input.value.replace(',', '.')) || 0;
                    const min = parseFloat(input.getAttribute('min')) || 0;
                    const max = parseFloat(input.getAttribute('data-maximum-quantity')) || Infinity;
                    const step = isFractional ? 0.001 : 1;

                    if (value > max) {
                        showStockMessage();
                    }

                    value = Math.min(value, max);
                    value = Math.max(value, min);
                    value = Math.round(value / step) * step;

                    input.value = value.toFixed(isFractional ? 3 : 0);
                });
            });
        });
    </script>

{% endblock %}

