{% set form = flexy_ftwo_form('login').login %}

{% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-login-error'), 'error' : true} %}
{% include 'FlexyFtwoStoreBundle:Include:alerts.html.twig' with {'alerts' : app.session.flashbag.get('store-customer-create-success'), 'error' : false } %}

<section>
    <div class="second-page-container">
        <div class="block">
            <div class="container">
                <div class="header-for-light">
                    <h1 class="wow fadeInRight animated animated" data-wow-duration="1s" style="visibility: visible;-webkit-animation-duration: 1s; -moz-animation-duration: 1s; animation-duration: 1s;">
                        <span>Entrar</span> ou <span>Criar conta</span>
                    </h1>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                        <div class="block-form box-border wow fadeInLeft animated" data-wow-duration="1s">
                            <h3><i class="fa fa-user"></i> Já sou cliente</h3>
                            <p>Digite suas credenciais de acesso</p>

                            <form action="{{ path('login_check') }}" method="post">
                                {% set redirectTo = app.request.get('redirect') %}
                            	{% if redirectTo %}
                                	<input type="hidden" name="redirectTo" value="{{ redirectTo }}" />
                                {% endif %}

                                <div class="row">
                                    <div class="col-md-6">
                                        {{ form_widget(form._username, { 'attr': {'class': 'form-control', 'placeholder' : 'Digite seu e-mail ou CPF/CNPJ'}, 'type' : 'text'  }) }}
                                        {{ form_errors(form._username) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_widget(form._password, {'attr': {'class': 'form-control', 'placeholder' : 'Digite sua senha'}, }) }}
                                        {{ form_errors(form._password) }}
                                    </div>
                                    <div class="col-md-12">
                                    	<hr>
                                    </div>
                                    <div class="col-md-6">
                                        <a href="{{ path('flexy_ftwo_store_user_remember_password') }}">Esqueci minha senha</a>
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <input type="submit" value="Entrar" class="btn-default-1">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                        <div class="block-form box-border wow fadeInRight animated" data-wow-duration="1s">
                            <h3><i class="fa fa-shopping-cart"></i> Primeira compra</h3>
                            <p>Crie uma conta conosco para poder aproveitar todas as nossas ofertas.</p>
                            <form action="{{ path('flexy_ftwo_store_customer_create') }}" method="get">
                                <div class="row">
                                    <div class="col-md-12">
                                        <input type="email" placeholder="E-mail" name="email" class="form-control emailInput" />
                                    </div>
                                    <div class="col-md-12">
                                    	<hr>
                                    </div>
                                	<div class="col-md-12 text-right">
                                        <input class="btn-default-1" value="Criar conta" type="submit" />
                                    </div>
                                </div>
							</form>
                        </div>
                    </div>
                </div>
                {% if facebookLoginUrl or googleLoginUrl or microsoftLoginUrl or microsoftLoginCnpjUrl %}
                    <div class="row">
                        <div class="col-md-12">
                            <hr>
                        </div>
                        {% if facebookLoginUrl %}
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-facebook" href="{{ facebookLoginUrl }}">
                                    <span class="fa fa-facebook"></span> Entrar com Facebook
                                </a>
                            </div>
                        {% endif %}

                        {% if googleLoginUrl %}
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-google" href="{{ googleLoginUrl }}">
                                    <span class="fa fa-google"></span> Entrar com Google
                                </a>
                            </div>
                        {% endif %}

                        {% if microsoftLoginCnpjUrl or microsoftLoginCnpjUrl %}
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-microsoft" href="{{ microsoftLoginUrl }}">
                                    <div class="microsoft-icon">
                                        <svg 
                                            aria-hidden="true" 
                                            focusable="false" 
                                            data-prefix="fab" 
                                            data-icon="microsoft" 
                                            class="svg-inline--fa fa-microsoft fa-w-14" 
                                            role="img" 
                                            xmlns="http://www.w3.org/2000/svg" 
                                            viewBox="0 0 448 512">
                                                <path fill="currentColor" d="M0 32h214.6v214.6H0V32zm233.4 0H448v214.6H233.4V32zM0 265.4h214.6V480H0V265.4zm233.4 0H448V480H233.4V265.4z"></path>
                                        </svg>
                                    </div>
                                    Entrar com Microsoft
                                </a>
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-microsoft" href="{{ microsoftLoginCnpjUrl }}">
                                    <div class="microsoft-icon">
                                        <svg 
                                            aria-hidden="true" 
                                            focusable="false" 
                                            data-prefix="fab" 
                                            data-icon="microsoft" 
                                            class="svg-inline--fa fa-microsoft fa-w-14" 
                                            role="img" 
                                            xmlns="http://www.w3.org/2000/svg" 
                                            viewBox="0 0 448 512">
                                                <path fill="currentColor" d="M0 32h214.6v214.6H0V32zm233.4 0H448v214.6H233.4V32zM0 265.4h214.6V480H0V265.4zm233.4 0H448V480H233.4V265.4z"></path>
                                        </svg>
                                    </div>
                                    Entrar com Microsoft (PJ)
                                </a>
                            </div>
                        {% endif %}

                        {% if microsoftRegisterUrl or microsoftRegisterCnpjUrl %}
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-microsoft" href="{{ microsoftRegisterUrl }}">
                                    <div class="microsoft-icon">
                                        <svg
                                                aria-hidden="true"
                                                focusable="false"
                                                data-prefix="fab"
                                                data-icon="microsoft"
                                                class="svg-inline--fa fa-microsoft fa-w-14"
                                                role="img"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 448 512">
                                            <path fill="currentColor" d="M0 32h214.6v214.6H0V32zm233.4 0H448v214.6H233.4V32zM0 265.4h214.6V480H0V265.4zm233.4 0H448V480H233.4V265.4z"></path>
                                        </svg>
                                    </div>
                                    Cadastrar com Microsoft
                                </a>
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3">
                                <a class="btn btn-block btn-social btn-microsoft" href="{{ microsoftRegisterCnpjUrl }}">
                                    <div class="microsoft-icon">
                                        <svg
                                                aria-hidden="true"
                                                focusable="false"
                                                data-prefix="fab"
                                                data-icon="microsoft"
                                                class="svg-inline--fa fa-microsoft fa-w-14"
                                                role="img"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 448 512">
                                            <path fill="currentColor" d="M0 32h214.6v214.6H0V32zm233.4 0H448v214.6H233.4V32zM0 265.4h214.6V480H0V265.4zm233.4 0H448V480H233.4V265.4z"></path>
                                        </svg>
                                    </div>
                                    Cadastrar com Microsoft (PJ)
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</section>
