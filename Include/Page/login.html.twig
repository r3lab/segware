<script src="{{ flexy_ftwo_resource_url_js('js/browser-fingerprint.js') }}"></script>
<script type="text/javascript">
  (function() {
    'use strict';

    function attachFingerprintToForm(form) {
      if (!form || !window.BrowserFingerprint) {
        return;
      }

      form.addEventListener('submit', function(e) {
        var existingField = form.querySelector('input[name="_client_fp"]');
        if (existingField && existingField.value) {

          return true;
        }

        e.preventDefault();

        window.BrowserFingerprint.addToForm(form).then(function() {
          form.submit();
        }).catch(function() {
          form.submit();
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var mainLoginForm = document.querySelector('form[action="{{ path('login_check') }}"]');
      if (mainLoginForm) {
        attachFingerprintToForm(mainLoginForm);
      }

      var edbForm = document.getElementById('form-login-db');
      if (edbForm) {
        attachFingerprintToForm(edbForm);
      }

      var flexyEdbForms = document.querySelectorAll('form[action="{{ path('flexy_ftwo_store_customer_login_flexy_db') }}"]');
      flexyEdbForms.forEach(function(form) {
        attachFingerprintToForm(form);
      });
    });
  })();

  document.getElementById("login-sienge-id").addEventListener("click", function() {
    let url = document.getElementById('login-url-sienge-id')
    let email = document.getElementById('input-email-sienge-id')
    let errorMsg = document.getElementById('alert-error-sienge-id')

    if (!email.value) {
      errorMsg.style.display = 'block';

      return;
    }

    window.location.href = `${url.value}&login_hint=${email.value}`
  });
</script>
