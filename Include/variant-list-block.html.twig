<div class="">
    <div class="block-products-modes color-scheme-2">
        <i class="fa fa-tags"></i>
        <a>{{ title }}</a>
        <a href="#" class="filter-menu-btn hidden-lg hidden-md">Filtrar</a>
    </div>

    {% if variants|length > 0 %}
        <div class="row">
            {% for variant in variants %}
                <div class="col-md-4">
                    {% include 'FlexyFtwoStoreBundle:Include:variant.html.twig' %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center">
            <p class="nothing-found">Nenhum produto encontrado.</p>
        </div>
    {% endif %}
</div>