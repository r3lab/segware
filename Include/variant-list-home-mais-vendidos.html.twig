<section id="variant-list">
    <div class="second-page-container home">
        <h2>{{titleCategory}}</h2>
        <div class="variant-list">
            <div class="mv-container">
                <div class="carousel-mv-home">
                    <div class="mv-inner">
                        <div class="swiper-container slide">
                            <div class="swiper-wrapper">
                                {% for variant in variants %}
                                    <div class="swiper-slide mv-item">
                                        {% include 'FlexyFtwoStoreBundle:Include:variant.html.twig' with {variant : variant} %}
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="swiper-pagination"></div>
                        </div>
                        {% if variants|length > 4 %}
                            <div class="btn-prev-mv">
                            	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
                                  <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
                                </svg>
                            </div>
                            <div class="btn-next-mv">
                            	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
                                  <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    <div>
</section>

{% block javascript %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Mais Vendidos Home
            var maisVendidosSwiper = new Swiper('.carousel-mv-home .slide', {
                
                slidesPerView: 4,
                loop: false,
                spaceBetween: 10,
                
                navigation: {
                    nextEl: '.btn-next-mv',
                    prevEl: '.btn-prev-mv'
                },
                
                autoplay: {
                    delay: 8000,
                    pauseOnMouseEnter: true,
                    disableOnInteraction: true
                },
                speed: 600,

                preloadImages: false,
                lazy: true,

                watchSlidesProgress: true,
                preventClicks: true,
                preventClicksPropagation: true,
                threshold: 8,

                observer: false,
                observeParents: false,
                
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                
                on: {
                    init: function() {
                        setTimeout(function() {
                            var images = document.querySelectorAll(".carousel-mv-home");
                            images.forEach(function(image) {
                            //image.style.visibility = "visible";
                            image.style.opacity = "1"; // Aplica o fade-in
                            });
                        }, 500);
                    }
                },
                breakpoints: {
                    300: {
                        slidesPerView: 2
                    },
                    640: {
                        slidesPerView: 2
                    },
                    768: {
                        slidesPerView: 2
                    },
                    992: {
                        slidesPerView: 3
                    },
                    1199: {
                        slidesPerView: 4
                    },
                }
            });
        });
    </script>
 {% endblock %}