		</div>
		<div class="row tab-pane" id="subscriptionsplans">
			<article class="col-md-12">
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr>
								<th>Número</th>
								<th>Realizado em</th>
								{% if showMultipleUsers %}
									<th>Usuário</th>
								{% endif %}
								<th>Itens</th>
								<th>Intervalo</th>
								<th>Total</th>
								{% if agent is defined %}
									<th>Comissão</th>
								{% endif %}
								<th>&nbsp;</th>
							</tr>
						</thead>
						<tbody>
							{% for order in ordersWithSubscriptionPlans if order.user.id == loginUser.id or loginUser.master %}
								<tr>
									<td>
										<a href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : order.id}) }}">{{ order.number }}</a>
									</td>
									<td>{{ order.createdAt|date("d/m/Y") }}</td>
									{% if showMultipleUsers %}
										<td>{{ order.user and not order.user.master ? order.user.name : order.customer.responsible }}</td>
									{% endif %}
									<td>{{ order.items|length }}
										<span>item(ns)</span>
									</td>
									<td>{{ order.orderSubscriptionPlan.intervalLabel }}</td>
									<td>R$
										{{ order.billingTotal|number_format(2, ',', '.') }}</td>
									{% if agent is defined %}
										<td>{{ order.agentCommissionValueByAgent(agent)|number_format(2, ',', '.') }}</td>
									{% endif %}
									<td class="text-right">
										<a class="btn btn-mini" href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : order.id}) }}" title="Ver detalhes">
											<i class="fa fa-plus-circle"></i>
										</a>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6">
										<h3>Nenhum pedido realizado.</h3>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</article>
		</div>
		<div class="row tab-pane" id="bookings">
			<article class="col-md-12">
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr>
								<th>Número</th>
								{% if store.info.usesMultipleSales %}
									<th>Loja</th>
								{% endif %}
								<th>Realizado em</th>
								{% if showMultipleUsers %}
									<th>Usuário</th>
								{% endif %}
								<th>Itens</th>
								<th>Período do Aluguel</th>
								<th>Total</th>
								<th>&nbsp;</th>
							</tr>
						</thead>
						<tbody>
							{% for booking in ordersWithBookings if order.user.id == loginUser.id or loginUser.master %}
								<tr>
									<td>
										<a href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : booking.id}) }}">{{ booking.number }}</a>
									</td>
									{% if store.info.usesMultipleSales %}
										<td>{{ booking.shoppingStore.name }}</td>
									{% endif %}
									<td>{{ booking.createdAt|date("d/m/Y") }}</td>
									{% if showMultipleUsers %}
										<td>{{ booking.user and not booking.user.master ? booking.user.name : booking.customer.responsible }}</td>
									{% endif %}
									<td>{{ booking.items|length }}
										<span>item(ns)</span>
									</td>
									<td>{{ booking.items.first.booking.start|date('d/m/Y') }}
										até
										{{ booking.items.first.booking.end|date('d/m/Y') }}</td>
									<td>R$
										{{ booking.billingTotal|number_format(2, ',', '.') }}</td>
									{% if agent is defined %}
										<td>{{ booking.agentCommissionValueByAgent(agent)|number_format(2, ',', '.') }}</td>
									{% endif %}
									<td class="text-right">
										<a class="btn btn-mini" href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : booking.id}) }}" title="Ver detalhes">
											<i class="fa fa-plus-circle"></i>
										</a>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6">
										<h3>Nenhum pedido realizado.</h3>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</article>
		</div>
		<div class="row tab-pane" id="coupons">
			<article class="col-md-12">
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr>
								<th>Código do Cupom</th>
								<th>Desconto</th>
								<th>Válido até</th>
								{% if store.info.usesMultipleSales %}
									<th>Aplicado em</th>
								{% endif %}
								<th>Quantidade Disponível</th>
							</tr>
						</thead>
						<tbody>
							<!-- TODO : add availabe promotion service extention to bring usable pormotions as dto with details on condition of used -->
							{% for promotion in customer.availableCoupons %}
								<tr>
									<td>{{ promotion.coupons.first.code }}</td>
									<td>{{ promotion.isDiscountMoney ? promotion.discountType ~ promotion.discountValue : promotion.discountValue ~ promotion.discountType }}</td>
									<td>{{ promotion.endDate|date("d/m/Y") }}</td>
									{% if store.info.usesMultipleSales %}
										<td>{{ promotion.shoppingStore ? 'loja: '~ promotion.shoppingStore.name : "todas as lojas"}}</td>
									{% endif %}
									{% if promotion.usePerCustomer %}
										<td>{{ couponsCounter[promotion.id] }}</td>
									{% else %}
										<td>Ilimitado</td>
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="6">
										<h3>Nenhum cupom encontrado.</h3>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</article>
		</div>#}
	</div>
</div>