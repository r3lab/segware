{% set loginUser = app.user %}
{#{% set showMultipleUsers = not store.info.usesMultipleSales and loginUser.master and customer.cnpj %}#}
{% set showMultipleUsers = true %}

{% if customer %}
	{% set quotesPagination = f2_customer_quote_list(
		{
			'customerId' : customer.id,
			'shoppingStoreReferenceCode' : (shoppingStoreReferenceCode is defined)?shoppingStoreReferenceCode:null,
		}
	)
%}	
{% else %}
	{% set customerIds = [] %}
	{% for customer in agent.customers %}
		{% set customerIds = customerIds | merge([customer.id]) %}
	{% endfor %}

	{% set quotesPagination = f2_customer_quote_list(
		{
			'customerIds' : customerIds,
			'shoppingStoreReferenceCode' : (shoppingStoreReferenceCode is defined)?shoppingStoreReferenceCode:null,
		}
	)
	%}
{% endif %}

{% set pagination = f2_customer_order_list_pagination(
    {
        'customerId' : customer.id,
        'agentId' : (agent is defined)?agent.id:null,
        'shoppingStoreReferenceCode' : (shoppingStoreReferenceCode is defined)?shoppingStoreReferenceCode:null,
    }
)
%}
{% set ordersWithSubscriptionPlans = f2_customer_order_list(
{
'customerId' : customer.id ,
'agentId' : (agent is defined)?agent.id:null,
'onlyOriginalSubscriptions': true
}
)
%}

{% set ordersWithBookings = f2_customer_order_list(
        {
            'customerId' : customer.id ,
            'agentId' : (agent is defined)?agent.id:null,
            'hasBooking': true,
        }
    )
%}

<div class="customer-profile">
	<article>
		<ul class="nav nav-pills nav-justified">
			<li class="active">
				<a href="#orders" data-toggle="tab">Pedidos</a>
			</li>
			<li>
				<a href="#quotes" data-toggle="tab">Orçamentos</a>
			</li>
			<li>
				<a href="#subscriptionsplans" data-toggle="tab">Assinaturas</a>
			</li>
			<li>
				<a href="#bookings" data-toggle="tab">Aluguéis</a>
			</li>
			<li>
				<a href="#coupons" data-toggle="tab">Cupons</a>
			</li>
		</ul>
	</article>
	<div class="tab-content">
		<div class="row tab-pane active" id="orders">
			<article class="col-xs-12 col-sm-12">
				<div class="box-border wow fadeInLeft" data-wow-duration="1s">
					<div class="table-responsive">
						<table class="table table-hover">
							<thead>
								<tr>
									<th>Número</th>
									{% if store.info.usesMultipleSales %}
										<th>Loja</th>
									{% endif %}
									<th>Realizado em</th>
									{% if showMultipleUsers %}
										<th>Usuário</th>
									{% endif %}
									<th>Itens</th>
									<th>Andamento</th>
									<th>Total</th>
									{% if agent is defined %}
										<th>Comissão</th>
									{% endif %}
									<th>&nbsp;</th>
								</tr>
							</thead>
							<tbody>
								{#{% for order in pagination if ((order.user)?order.user.id == loginUser.id:false) or loginUser.master or isEdbLoginEnabled %}#}
                                {% for order in pagination %}
									<tr>
										<td>
											<a href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : order.id}) }}">{{ order.number }}</a>
										</td>
										{% if store.info.usesMultipleSales %}
											<td>{{ order.shoppingStore.name }}</td>
										{% endif %}
										<td>{{ order.createdAt|date("d/m/Y") }}</td>
										{% if showMultipleUsers %}
											<td>{{ order.user and not order.user.master ? order.user.name : order.customer.responsible }}</td>
										{% endif %}
										<td>{{ order.items|length }}
											<span>item(ns)</span>
										</td>
										<td>
											<span class="label">{{ orderPresentations[order.status.name] is defined ?: order.status.presentation }}</span>
										</td>
										<td>R$
											{{ order.total|number_format(2, ',', '.') }}</td>
										{% if agent is defined %}
											<td>{{ order.agentCommissionValueByAgent(agent)|number_format(2, ',', '.') }}</td>
										{% endif %}
										<td class="text-right">
											{% if not order.orderSubscriptionPlan and order.cart %}
												{#<a href="{{ path('flexy_ftwo_store_customer_order_redo', {'orderId': order.id}) }}" title="Refazer pedido"><i class="fa fa-files-o"></i></a> by OrderId #}
												<a href="{{ path('flexy_ftwo_store_customer_reorder', {'orderNumber': order.number}) }}" class="remake-order" title="Refazer pedido">
													<i class="fa fa-files-o"></i>
												</a>
												{# by OrderNumber #}
											{% endif %}
											<a class="btn btn-mini" href="{{ path("flexy_ftwo_store_customer_order_detail", {orderId : order.id}) }}" title="Ver detalhes">
												<i class="fa fa-plus-circle"></i>
											</a>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="6">
											<h3>Nenhum pedido realizado.</h3>
										</td>
									</tr>
								{% endfor %}
								{% if agent is defined %}
									<tr>
										<td colspan="8">
											<p style="text-align:center">
												* exibindo os resultados dos últimos 30 dias. Para acessar pedidos de datas anteriores use o filtro de data do
												<a href="{{ path("flexy_ftwo_store_dashboard_agent_commission_dashboard") }}">
													Painel de Vendas.
												</a>
											</p>
										</td>
									</tr>
								{% endif %}
							</tbody>
						</table>
					</div>
					<div class="row">
						{{ knp_pagination_render(pagination) }}
					</div>
				</div>
			</article>
		</div>
		{#<div class="row tab-pane" id="quotes">
			<article class="col-md-12">
				<div class="table-responsive">
					<table class="table table-hover">
