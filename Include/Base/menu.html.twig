<div class="header-bottom-inner">
	{# Desktop #}
	<div class="container d-none d-sm-block" >
	    <div class="row">
            <div class="mega-menu-full-width">
			    <div style="display: flex; align-items: center; justify-content: space-between;">
			        <div class="main-menu hidden-sm hidden-xs">
			            <nav>
			                <ul>
                            	{% set countLast = 0 %}

                                {% set root = flexy_ftwo_category_list(flexy_ftwo_category_list_by_parent_reference_code('departamentos'), 'sortOrder-desc') %}
                                {% set rootCategories = root and root.categories ? root.categories : [] %}

                                {% for category in rootCategories|slice(0,9) %}
                                	
                                    {% set result = flexy_ftwo_category_list(category) %}
                                    {% set subCategories = result and result.categories ? result.categories : [] %}

                                    {% set countLast = countLast+1 %}
				                    <li class="dropdown-cat {{subCategories ? 'submenu-itens'}}">
                                        <a href="{{ path("flexy_ftwo_store_product_list", {categoryReferenceCode : category.referenceCode}) }}">
                                        {{ category.name }} {{ subCategories|length > 0 ? '<i class="fa fa-chevron-down"></i>'}}
                                        </a>
				                    	{% if subCategories|length > 0 %}            
                                            <div class="dropdown_menu">
                                                <div class="itens-list col-md-6">
                                                    <ul{{ subCategories|length > 15 ? ' class="scroll-list"'}}>
                                                        {% for subCategory in flexy_ftwo_category_list(flexy_ftwo_category_list_by_parent_reference_code(category.referenceCode), 'name-asc').categories %}                                                        
                                                            {% set subSubCategories = flexy_ftwo_category_list(subCategory, 'name-asc', null).categories  %}
                                                            <li class="dropdown-cat {{subCategories ? 'submenu-itens-level'}}">
                                                               <a  href="{{ path("flexy_ftwo_store_product_list", {categoryReferenceCode : subCategory.referenceCode}) }}">
                                                                {{ subCategory.name }} {{ subSubCategories ? '<i class="fa fa-chevron-right"></i>'}}
                                                               </a>
															   {% if subSubCategories %}
                                                               <div class="submenu dropdown_menu" {% if countLast == 5 or countLast == 6 %} style="right: 100%;left: auto;margin-right: 0;" {% endif %}>
																	<div class="itens-list col-md-6">
																		<ul>
																			{% for subSubCategory in subSubCategories %}
																				<li>
																					<a class="dropdown-item" href="{{ path("flexy_ftwo_store_product_list", {categoryReferenceCode : subSubCategory.referenceCode}) }}">{{ subSubCategory.name }}</a>
																				</li>
																			{% endfor %}
																		</ul>
																	</div>
																</div>
                                                                {% endif %}
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            </div>
				                        {% endif %}
				                    </li>
				                {% endfor %}
			                </ul>
			            </nav>
                        {#<nav>
                            <ul style="justify-content: flex-end;">
                                <li class="dropdown-cat all-items">
                                    <a href="/produto/listar">Todos os produtos</a>
                                </li>
                            </ul>
                        </nav>#}
			        </div>
			    </div>
			</div>
		</div>
	</div>
	{# End Desktop #}
</div>