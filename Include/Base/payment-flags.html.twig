<div class="container-fluid middle-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-9 new-menu-footer hidden-xs hidden-sm">
                <img src="{{ store.info.logoUrl }}" alt="{{ store.info.tradingName }}" class="logo-footer">
                <br class="responsive" style="display: none;">
                <div class="footer-contact-info">
                    <p>
                        <span><i class="fa fa-phone"></i>
                            {{ store.info.primaryPhone }}
                        </span>



                        <span><i class="fa fa-envelope"></i> {{ store.info.email }}</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>