<div class="container-fluid bottom-footer">
    <div class="container">
        <div class="row">
            <div class="col-sm-4">
                <div class="row">
                    <div class="col-md-12">
                          	{% if status_code == '404' %}
                                <p>Segware</p>
                                <p>CNPJ:</p>
                                <p>Endereço:<br></p>
                            {% else %}
                                <p>{{ shoppingStore ? store.shoppingStore.name : store.info.companyName }}</p>
                                <p>CNPJ: {{ shoppingStore ? store.shoppingStore.cnpj : store.info.cnpj }}</p>
                                <p>
                                    {#{{ store.info.address }}#}
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.street : store.info.distributionCenter.street }}
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.number : store.info.distributionCenter.number }},
                                    {% if shoppingStore %}
                                        {% if store.shoppingStore.distributionCenter.complement == true %}
                                            {{ store.shoppingStore.distributionCenter.complement }},
                                        {% endif %}
                                    {% else %}
                                        {% if store.info.distributionCenter.complement == true %}
                                            {{ store.info.distributionCenter.complement }},
                                        {% endif %}
                                    {% endif %}
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.district : store.info.distributionCenter.district }},
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.postcode[:5] : store.info.distributionCenter.postcode[:5] }}-{{ shoppingStore ? store.shoppingStore.distributionCenter.postcode[5:] : store.info.distributionCenter.postcode[5:] }},<br>
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.city : store.info.distributionCenter.city }},
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.state : store.info.distributionCenter.state }},
                                    {{ shoppingStore ? store.shoppingStore.distributionCenter.country : store.info.distributionCenter.country }}.
                                    <br>
                                </p>
							{% endif %}
                            <br>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-sm-8 col-xs-12">
                <div class="row xs-top20">
                    <div class="col-md-4 col-sm-4 col-xs-12">
                        {% set paymentMethodIcons = store.paymentMethod.icons %}
                        {% if paymentMethodIcons|length > 0 %}
                            <p class="title-copyright">Pagamento</p>
                            {% for paymentMethodIcon in paymentMethodIcons %}
                                <img src="{{ paymentMethodIcon.iconUrl }}" title="{{ paymentMethodIcon.name }}" style="display: inline-block; width: 20%; max-width: 50px;" />
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="delos">
                        <div class="col-md-4 col-sm-4 col-xs-6">
                            <p class="title-copyright">Segurança</p>
                            <a href="https://www.comodo.com/" target="_blank"><img src="{{ flexy_ftwo_resource_url_img('img/comodo.png') }}" class="comodo img-responsive" /></a>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-6">
                            <p class="title-copyright">Plataforma</p>
                            <a href="https://www.flexy.com.br" target="_blank">
                                <img src="{{ flexy_ftwo_resource_url_img('img/flexy.png') }}" class="img-responsive" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>