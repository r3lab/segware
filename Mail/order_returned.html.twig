{% set infoMessage = "" %}
{% if order.status.info %}
{% set infoMessage = "<p>Mensagem informativa: \"" ~ order.status.info ~ "\"<p>" %}
{% endif %}
{% include 'FlexyFtwoStoreBundle:Mail:order.html.twig' with {
'order' : order,
'title': 'Pedido devolvido!',
'message' : "Olá, " ~ order.customer.fullName ~ ".<br />
           <p>Seu pedido, número <b>" ~  order.number ~ "</b>, foi devolvido.</p>
            " ~ infoMessage ~ "
           <p>Você pode refazer o pedido a qualquer momento, através do link abaixo:</p>
           <p style='margin-top:30px;'><a style='" ~ style.button ~ "' href='" ~ url('flexy_ftwo_store_customer_order_redo', {'orderId': order.id}) ~ "'>Refazer pedido</a></p>
           <br/>
           <p>Segue abaixo um resumo de seu pedido.</p>"
} %}