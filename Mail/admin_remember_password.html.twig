{% extends 'FlexyFtwoStoreBundle:Mail:base-internal.html.twig' %}
{% block content %}
    {% set link = url('flexy_ftwo_platform_user_redefine_password', {'token' : user.confirmationToken }) %}
    <div style="{{ style.header }}">
        <h1>Recupere sua senha!</h1>
    </div>
    <div style="{{ style.inner }}">
        <h3>Olá, {{ user.name }}.</h3>
        <p>Recebemos uma solicitação para alterar sua senha do painel administrativo, e por isto você esta recebendo este e-mail.</p>
        <p>Para alterar sua senha clique no link abaixo e crie uma nova senha.</p>
        <p><a href="{{ link }}">{{ link }}</a></p>
        <p>Caso você não tenha solicitado esta recuperação de senha, por favor, ignore este e-mail.</p>
        {{ mailSignature|raw }}

    </div>
{% endblock %}