{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}
{% block title %}Quote{% endblock %}
{% set quoteVariables = flexy_ftwo_quote_list() %}
{% set quoteUrl = path('flexy_ftwo_store_quote_finish') %}
{% set quoteUploadConfiguration = flexy_ftwo_configuration_stores("QUOTE_UPLOAD_CONFIGURATION") %}
{% block content %}
    <section>
        <form method="post" action="{{ quoteUrl }}" class="f2-form" id="quote-form">
            <div class="second-page-container">
                <div class="container">
                    {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [{'title' : 'Orçamento' }]} %}
                    {% for flashMessage in app.session.flashbag.get('store-error') %}
                        <div class="alert alert-danger">
                            {{ flashMessage|trans }}
                        </div>
                    {% endfor %}
                    <div class="header-for-light">
                        <h1>Orçamento</h1>
                    </div>
                    {% if quoteVariables.quote.allItems.count > 0 %}
                        {% set hasOrphanSale = quoteVariables.quote.hasOrphanSale %}
                        {% set hasNoOrphanSale = not hasOrphanSale %}
                        {% set quotes = quoteVariables.quotes %}
                        {% include 'FlexyFtwoStoreBundle:Include/Cart:cart-list.html.twig' with {
                            carts : quotes,
                            changeQuantity : true,
                            remove: true,
                            hasOrphanSale: hasOrphanSale,
                            quoteUploadConfiguration: quoteUploadConfiguration
                        } %}
                        <div class="row">
                            {% if hasOrphanSale %}
                                <div class="col-md-4">
                                    <div class="row">
                                        <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                            <div class="block-form box-border wow fadeInLeft" data-wow-duration="1s">
                                                <h3><i class="fa fa-truck"></i> CEP de entrega</h3>
                                                <hr/>
                                                {% if not hasNoOrphanSale %}
                                                    É necessário preencher o CEP de entrega antes de solicitar o orçamento.
                                                {% endif %}
                                                <div class="input-group">
                                                    <input type="text" class="flexy-input-postcode form-control"
                                                           name="zipCode" placeholder="Digite seu cep"
                                                           value="{{ app.request.get('zipCode') }}">
                                                    <span class="input-group-btn">
                                                <input type="button" class="btn btn-default-1 btn-cep" id="zipCode"
                                                       value="Enviar"/>
                                            </span>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                </div>
                                <div class="col-md-8"></div>
                            {% endif %}
                            
                            <div>
                                <div class="quote-actions col-md-12">
                                    {% if flexy_ftwo_current_user_exists() and hasNoOrphanSale %}
                                        <a href="{{ path('flexy_ftwo_store_quote_export', { 'quoteId' : quoteVariables.quote.id}) }}"
                                           class="btn btn-default print-quote">
                                            <i class="bi bi-printer"></i>&nbsp;Imprimir orçamento
                                        </a>
                                    {% endif %}
                                    {% if hasNoOrphanSale %}
                                        <button type="submit" class="btn btn-checkout btn-light-blue" id="quote-request-button">
                                            <i class="bi bi-file-earmark"></i>&nbsp;Solicitar orçamento
                                        </button>
                                    {% endif %}
                            	</div>
                            </div>
                        </div>
                    {% else %}
                        <div class="header-for-light">
                            <h2 class="emptyCart">
                                Nenhum produto em seu orçamento.
                            </h2>
                            <a href="/">&larr; Voltar</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </form>
    </section>
{% endblock %}
{% block javascript %}
    <script src="{{ asset('bundles/flexyftwostore/js/quote/attach.js') }}"></script>
{% endblock %}