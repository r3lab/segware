{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% set title = article.title %}

{% block content %}
    <div class="second-page-container">
        <div class="container">
            {% include 'FlexyFtwoStoreBundle:Include:breadcrumbs.html.twig' with {path : [{'url' : path('flexy_ftwo_store_article_list'), 'title' : 'Blog'}, {'title' : article.title}]} %}

            <div class="row">
                <div class="col-md-12">
                    <div class="block-blog">
                        {% if article.thumbnail %}
                            <img alt="" class="img-responsive" src="{{ article.thumbnail }}">
                        {% endif %}

                        <div class="block">
                            <div class="header-for-light">
                                <h1 class="wow fadeInRight animated animated" data-wow-duration="1s" style="visibility: visible;-webkit-animation-duration: 1s; -moz-animation-duration: 1s; animation-duration: 1s;">{{ article.title }}</h1>
                            </div>
                            <br/>
                            <p>{{ article.referenceDate|date("d/m/Y") }}</p>
                            <br/>
                            {{ article.content|raw }}
                            <br/>
                            <div class="addthis_sharing_toolbox" data-media = "{{ article.thumbnail }}"></div>
                            <br/>
                            <div>
                                <a href="{{ path('flexy_ftwo_store_article_list') }}">&larr; Ver outras notícias</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block javascript %}
    <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-53fcef104475215a"></script>
{% endblock %}