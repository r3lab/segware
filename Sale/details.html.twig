{% set currentUser = flexy_ftwo_admin_current_user() %}
{% set sales = sale.sales.count ? sale.sales : [sale] %}
{% set currentCustomer = flexy_ftwo_current_customer() %}
{% set currentCriteria = flexy_ftwo_current_price_list_criteria() %}
{% set promotionTypeBaseConstant = '\\Flexy\\Ftwo\\Store\\Entity\\PromotionType::' %}

{% macro promotionName(promotionApplied) %}
    {% set promotionName = promotionApplied.promotion.name %}
    {% if promotionApplied.promotion.isCouponPromotion %}
        {% set promotionName = promotionName ~ ' (' ~ (promotionApplied.promotion.coupon.code) ~ ')' %}
    {% endif %}

    {% if promotionApplied.masterSale %}
        {% set promotionName = promotionName ~ ' (Carrinho Master)' %}
    {% endif %}

    {{ promotionName }}
{% endmacro %}

{% macro promotionTypeName(promotionApplied) %}
    {% set promotionTypeName = (promotionApplied.promotion.promotionType.name ~ '.singular')|trans %}
    {% if promotionApplied.promotion.shippingDiscount %}
        {% set promotionTypeName = promotionTypeName ~ ' (Frete incluso na promoção)' %}
    {% endif %}

    {{ promotionTypeName }}
{% endmacro %}

{% macro discountApplied(promotionApplied) %}
    {% set discountType = promotionApplied.discountType %}

    {% if discountType.isMoney %}
        {% set discountApplied = 'R$ ' %}
    {% endif %}

    {% set discountApplied = discountApplied ~ promotionApplied.discount|number_format(2, ',', '.') %}

    {% if discountType.isPercent %}
        {% set discountApplied = discountApplied  ~ '%' %}
    {% endif %}

    {% if promotionApplied.promotion.isCartBuyXGetY %}
        {% set discountApplied = discountApplied ~ ' (' ~ promotionApplied.quantity ~ ')' %}
    {% endif %}

    {{ discountApplied }}
{% endmacro %}

{% macro showPromotion(promotionApplied) %}
    <tr>
        <td>{{ _self.promotionName(promotionApplied) }}</td>
        <td>{{ _self.promotionTypeName(promotionApplied) }}</td>
        <td>{{ promotionApplied.promotion.priority ?: '---' }}</td>
        <td>{{ _self.discountApplied(promotionApplied) }}</td>
        <td class="text-right">R$ {{ promotionApplied.discountApplied|number_format(2, ',', '.') }}</td>
    </tr>
{% endmacro %}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>{% block title %}Current Sale{% endblock %}</title>
    <meta charset="utf-8">
    <link rel="shortcut icon" href="">
    <link rel="stylesheet" href="{{ asset('bundles/flexyftwostore/css/bootstrap.min.css') }}" />
    <script src="{{ asset('bundles/flexyftwostore/js/bootstrap.min.js') }}" type="text/javascript"></script>
</head>

<body>
    <div class="container">
        <h2>Cliente</h2>

        <table class="table table-striped table-bordered">
            <tr>
                <th>Agente</th>
                <th>Cliente</th>
                <th>Tipo de cliente</th>
                <th>Lista de preços</th>
            </tr>

            <tr>
                <td>{{ flexy_ftwo_current_agent().fullName ?: '---' }}</td>
                <td>{{ currentCustomer.fullName ?: '---' }}</td>
                <td>{{ currentCustomer.customerType.name ?: '---' }}</td>
                <td>{{ currentCriteria ? (currentCriteria.name ~ ' (' ~ currentCriteria.value ~ ', ' ~ currentCriteria.referenceCode ~ ')') : '---' }}</td>
            </tr>
        </table>

        <hr>

        {% if sale.isMasterSale and sale.sales.count %}
            <h2>{{ sale.id }} - Carrinho Master</h2>

            <table class="table table-striped table-bordered">
                <tr>
                    <th>Promoção</th>
                    <th>Tipo</th>
                    <th>Prioridade</th>
                    <th>Desconto</th>
                    <th class="text-right">Desconto Aplicado</th>
                </tr>

                {% set cartProgressivePromotions = sale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CART_PROGRESSIVE')) %}
                {% set cartPromotions = sale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CART')) %}
                {% set couponPromotions = sale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'COUPON')) %}
                {% set freeDeliveryPromotions = sale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'FREE_DELIVERY')) %}

                {% if cartProgressivePromotions.count %}
                    {% for cartProgressivePromotion in cartProgressivePromotions %}
                        {{ _self.showPromotion(cartProgressivePromotion) }}
                    {% endfor %}
                {% endif %}

                {% if cartPromotions.count %}
                    {% for cartPromotion in cartPromotions %}
                        {{ _self.showPromotion(cartPromotion) }}
                    {% endfor %}
                {% endif %}

                {% if couponPromotions.count %}
                    {% for couponPromotion in couponPromotions %}
                        {{ _self.showPromotion(couponPromotion) }}
                    {% endfor %}
                {% endif %}

                {% if freeDeliveryPromotions.count %}
                    {% for freeDeliveryPromotion in freeDeliveryPromotions %}
                        {{ _self.showPromotion(freeDeliveryPromotion) }}
                    {% endfor %}
                {% endif %}
            </table>

            <hr>
        {% endif %}

        {% for subSale in sales if subSale.items.count %}
            <h2>{{ subSale.id }} - Carrinho {{ subSale.shoppingStore ? subSale.shoppingStore.name : 'Shopping' }}</h2>

            <table class="table table-striped table-bordered">
                <tr>
                    <th>Promoção</th>
                    <th>Tipo</th>
                    <th>Prioridade</th>
                    <th>Desconto</th>
                    <th class="text-right">Desconto Aplicado</th>
                </tr>

                {% set cartProgressivePromotions = subSale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CART_PROGRESSIVE')) %}
                {% set cartPromotions = subSale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CART')) %}
                {% set couponPromotions = subSale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'COUPON')) %}
                {% set freeDeliveryPromotions = subSale.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'FREE_DELIVERY')) %}

                {% if cartProgressivePromotions.count %}
                    {% for cartProgressivePromotion in cartProgressivePromotions %}
                        {{ _self.showPromotion(cartProgressivePromotion) }}
                    {% endfor %}
                {% endif %}

                {% if cartPromotions.count %}
                    {% for cartPromotion in cartPromotions %}
                        {{ _self.showPromotion(cartPromotion) }}
                    {% endfor %}
                {% endif %}

                {% if couponPromotions.count %}
                    {% for couponPromotion in couponPromotions %}
                        {{ _self.showPromotion(couponPromotion) }}
                    {% endfor %}
                {% endif %}

                {% if freeDeliveryPromotions.count %}
                    {% for freeDeliveryPromotion in freeDeliveryPromotions %}
                        {{ _self.showPromotion(freeDeliveryPromotion) }}
                    {% endfor %}
                {% endif %}
            </table>

            <hr>

            {% for item in subSale.items %}
                <table class="table table-striped table-bordered">
                    <tr>
                        <th>Item</th>
                        <th>Qtd.</th>
                        <th>Preço unitário</th>
                        <th colspan="2">Preço total unitário</th>
                    </tr>

                    <tr>
                        <td>{{ item.variant.fullName }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>R$ {{ item.unitPrice|number_format(2, ',', '.') }}</td>
                        <td colspan="2" class="text-right">R$ {{ (item.priceAdapter.getTotalPrice)|number_format(2, ',', '.') }}</td>
                    </tr>

                    <tr>
                        <th>Promoção</th>
                        <th>Tipo</th>
                        <th>Prioridade</th>
                        <th>Desconto</th>
                        <th class="text-right">Desconto Aplicado</th>
                    </tr>

                    {% set catalogPromotions = item.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CATALOG')) %}
                    {% set progressivePromotions = item.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'PROGRESSIVE')) %}
                    {% set cartBuyXgetYPromotions = item.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'CART_BUY_X_GET_Y')) %}

                    {% if catalogPromotions.count %}
                        {% for catalogPromotion in catalogPromotions %}
                            {{ _self.showPromotion(catalogPromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if progressivePromotions.count %}
                        {% for progressivePromotion in progressivePromotions %}
                            {{ _self.showPromotion(progressivePromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if cartBuyXgetYPromotions.count %}
                        {% for cartBuyXgetYPromotion in cartBuyXgetYPromotions %}
                            {{ _self.showPromotion(cartBuyXgetYPromotion) }}
                        {% endfor %}
                    {% endif %}

                    <tr>
                        <th colspan="4" title="As promoções abaixo são calculadas sequencialmente (caso exista alguma), alterando sua base de cálculo a cada promoção seguindo essa ordem: progressiva por conjunto de itens, promoção de carrinho e cupom de desconto.">
                            SUBTOTAL
                            <svg width="1.2em" height="1.2em" viewBox="0 0 20 20" class="bi bi-question-circle" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"></path>
                                <path d="M5.25 6.033h1.32c0-.781.458-1.384 1.36-1.384.685 0 1.313.343 1.313 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.007.463h1.307v-.355c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.326 0-2.786.647-2.754 2.533zm1.562 5.516c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"></path>
                            </svg>
                        </th>
                        <td class="text-right">R$ {{ item.getTotalWithDiscount|number_format(2, ',', '.') }}</td>
                    </tr>

                    {% set cartProgressivePromotions = item.getPromotionsAppliedFromMasterSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'CART_PROGRESSIVE')) %}
                    {% set cartProgressiveStorePromotions = item.getPromotionsAppliedFromSubSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'CART_PROGRESSIVE')) %}

                    {% set cartPromotions = item.getPromotionsAppliedFromMasterSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'CART')) %}
                    {% set cartStorePromotions = item.getPromotionsAppliedFromSubSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'CART')) %}

                    {% set couponPromotions = item.getPromotionsAppliedByPromotionType(constant(promotionTypeBaseConstant ~ 'COUPON')) %}

                    {% set freeDeliveryPromotions = item.getPromotionsAppliedFromMasterSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'FREE_DELIVERY')) %}
                    {% set freeDeliveryStorePromotions = item.getPromotionsAppliedFromSubSaleByPromotionType(constant(promotionTypeBaseConstant ~ 'FREE_DELIVERY')) %}

                    {% if cartProgressivePromotions.count %}
                        {% for cartProgressivePromotion in cartProgressivePromotions %}
                            {{ _self.showPromotion(cartProgressivePromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if cartProgressiveStorePromotions.count %}
                        {% for cartProgressiveStorePromotion in cartProgressiveStorePromotions %}
                            {{ _self.showPromotion(cartProgressiveStorePromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if cartPromotions.count %}
                        {% for cartPromotion in cartPromotions %}
                            {{ _self.showPromotion(cartPromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if cartStorePromotions.count %}
                        {% for cartStorePromotion in cartStorePromotions %}
                            {{ _self.showPromotion(cartStorePromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if couponPromotions.count %}
                        {% for couponPromotion in couponPromotions %}
                            {{ _self.showPromotion(couponPromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if freeDeliveryPromotions.count %}
                        {% for freeDeliveryPromotion in freeDeliveryPromotions %}
                            {{ _self.showPromotion(freeDeliveryPromotion) }}
                        {% endfor %}
                    {% endif %}

                    {% if freeDeliveryStorePromotions.count %}
                        {% for freeDeliveryStorePromotion in freeDeliveryStorePromotions %}
                            {{ _self.showPromotion(freeDeliveryStorePromotion) }}
                        {% endfor %}
                    {% endif %}

                    <tr>
                        <th colspan="4">SUBTOTAL DE DESCONTOS</th>
                        <th class="text-right">R$ {{ item.getPromotionDiscountTotal|number_format(2, ',', '.') }}</th>
                    </tr>

                    <tr>
                        <th colspan="4">SUBTOTAL COM DESCONTOS APLICADOS</th>
                        <th class="text-right">R$ {{ item.getTotalWithAllPromotions|number_format(2, ',', '.') }}</th>
                    </tr>
                </table>

                <hr>
            {% endfor %}
        {% endfor %}

        <table class="table table-striped table-bordered">
            <tr>
                <th>SUBTOTAL</th>
                <td>R$ {{ sale.itemsTotal|number_format(2, ',', '.') }}</td>
            </tr>

            <tr>
                <th>DESCONTO DE ITEMS</th>
                <td>R$ {{ sale.priceAdapter.getItemsPromotionDiscountTotal|number_format(2, ',', '.') }}</td>
            </tr>

            <tr>
                <th>DESCONTO DE CARRINHO</th>
                <td>R$ {{ sale.getCartDiscounts|number_format(2, ',', '.') }}</td>
            </tr>

            <tr>
                <th>TOTAL DE DESCONTO</th>
                <td>R$ {{ sale.getPromotionDiscountTotal|number_format(2, ',', '.') }}</td>
            </tr>

            <tr>
                <th>TOTAL</th>
                <td>
                    <strong>R$ {{ sale.getTotalWithDiscount|number_format(2, ',', '.') }}</strong>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
