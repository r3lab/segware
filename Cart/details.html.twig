{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% block title %}Detalhes do carrinho{% endblock %}

{% block content %}
    <div class="page-title">
        <h1>
            Detalhes do carrinho
        </h1>
    </div>

    <div class="grid simple" style="">
        <div class="grid-body no-border" style="padding: 20px !important">
            <div class="row">
                <div class="col-md-12">
                    <p><strong>Criado em</strong>: {{ cart.createdAt.format('d/m/Y') }}</p>
                    <p><strong>Última atualização em</strong>: {{ cart.updatedAt.format('d/m/Y') }}</p>
                </div>
            </div>
        </div>
    </div>

    <p>
        <a href="{{ path('flexy_ftwo_store_cart_recovery', {id : cart.id}) }}" class="btn btn-default">Recuperar</a>
    </p>

    <div class="panel panel-default">
        <div class="panel-heading">Produtos</div>
        <div class="panel-body" style="padding: 0px;">

            <div class="grid simple">
                <div class="grid-body">
                    <div id="example3_wrapper"
                         class="dataTables_wrapper form-inline">
                        <table
                                class="table dataTable"
                                id="example3"
                                aria-describedby="example3_info">
                            <thead>
                            <tr role="row">
                            <th
                                    class="sorting"
                                    role="columnheader"
                                    tabindex="0"
                                    aria-controls="example3"
                                    rowspan="1"
                                    colspan="1"
                                    aria-label="Browser: activate to sort column ascending"
                                    style="width: 15%;">
                                Cód. Ref.
                            </th>
                            <th
                                    class="sorting_asc"
                                    role="columnheader"
                                    rowspan="1"
                                    colspan="1"
                                    aria-label="Rendering engine"
                                    style="width: 15%;">
                                Nome
                            </th>
                            <th
                                    class="sorting"
                                    role="columnheader"
                                    tabindex="0"
                                    aria-controls="example3"
                                    rowspan="1"
                                    colspan="1"
                                    aria-label="Platform(s): activate to sort column ascending"
                                    style="width: 10%;">
                                Quantidade
                            </th>
                            <th
                                    class="sorting"
                                    role="columnheader"
                                    tabindex="0"
                                    aria-controls="example3"
                                    rowspan="1"
                                    colspan="1"
                                    aria-label="Platform(s): activate to sort column ascending"
                                    style="width: 10%;">
                                Preço Un.
                            </th>
                            <th
                                    class="sorting"
                                    role="columnheader"
                                    tabindex="0"
                                    aria-controls="example3"
                                    rowspan="1"
                                    colspan="1"
                                    aria-label="Platform(s): activate to sort column ascending"
                                    style="width: 15%;">
                                Total
                            </th>
                            </thead>
                            <tbody role="alert" aria-live="polite"
                                   aria-relevant="all">
                            {% for item in cart.items %}
                                <tr>
                                    <td>{{ item.variant.referenceCode }}</td>
                                    <td>{{ item.variant.product.name }}</td>
                                    <td>
                                        {% if item.variant.isFractionalStock %}
                                            {{ item.quantity|number_format(3, ',', '.') }}
                                        {% else %}
                                            {{ item.quantity }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if store.config.displayPrice %}
                                            R$ {{ item.unitPrice|number_format(2, ',', '.') }}
                                        {% endif %}
                                    </td>
                                    <td>R$ {{ item.total|number_format(2, ',', '.') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                            {% if store.config.displayPrice %}
                            <tfoot>
                            <tr>
                                <td colspan="3"></td>
                                <td>Preço Total</td>
                                <td>
                                    {% if store.config.displayPrice %}
                                    <strong>R$ {{ cart.totalWithDiscount|number_format(2, ',', '.') }}</strong>
                                    {% else %}
                                        ---
                                    {% endif %}
                                </td>
                            </tr>
                            </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}