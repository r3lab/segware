{% extends 'FlexyFtwoStoreBundle:Layout:base.html.twig' %}

{% block title %}Atualização de representante{% endblock %}

{% block content %}
    {% block alerts %}
        <div class="messages">
            {% for flashMessage in app.session.flashbag.get('store-agent-update-success') %}
                <div class="alert alert-success">
                    {{ flashMessage|trans }}
                </div>
            {% endfor %}
            {% for flashMessage in app.session.flashbag.get('store-agent-update-error') %}
                <div class="alert alert-error">
                    {{ flashMessage|trans }}
                </div>
            {% endfor %}
        </div>
    {% endblock %}

    <form
        action="{{ path('flexy_ftwo_store_agent_update') }}"
        method="post"
        class="form-horizontal"
        role="form"
        style="padding: 10px">

        <div id="cpf" class="hide-type">
            <div class="form-group">
                <label for="agent_name" class="required">{{ 'generic.navigation.name.label'|trans }}</label>
                {{ form_errors(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="form-group">
            <label for="agent_phone" class="required">{{ 'generic.navigation.phone.label'|trans }}</label>
            {{ form_errors(form.phone) }}
            {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
        </div>
