<script type="text/javascript">
    /**
     * Manipule notify me when product unavailable
     * @author Marlon Hemkemaier
     */

    $(function() {
        $('.flexy-list-btn').click(function(event){event.preventDefault();$('.flexy-display-mode').addClass('flexy-list-display');});
        $('.flexy-grid-btn').click(function(event){event.preventDefault();$('.flexy-display-mode').removeClass('flexy-list-display');});
    });

</script>
