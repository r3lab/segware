<script type="text/javascript">
    /**
     * Manipule notify me when product unavailable
     * @author Jonatas Avila <jonatas.avila@flexy.com.br>
     */
    (function ($) {
        $('.saveNotifyMeWhen').click(function(){

            var idVariantNotify = $(this).attr('idVariantNotify');
            var emailNotify = $("#notifyMeWhen"+idVariantNotify).val();

            $('#refreshNotifyAvailable').show();

            if (emailNotify != '') {
                $.ajax({
                    url: "{{ path(createNotifyMeWhenProductAvailableAction) }}",
                    data: { email: emailNotify, variantId: idVariantNotify },
                    type: 'POST',
                    context: jQuery('#resultado'),
                    beforeSend: function(){
                    },
                    success: function(data){
                        $('#refreshNotifyAvailable').hide();

                        $("#notifyMeWhen"+idVariantNotify).hide();
                        $('.saveNotifyMeWhen').hide();
                        $('.notifyBox').append($('<div>').append(data.msg));
                    },
                    error: function (data) {
                        alert('Endereço de e-mail inválido.');
                        $('#refreshNotifyAvailable').hide();
                    }
                });
            } else {
                alert('Insira um e-mail válido!');
                $('#refreshNotifyAvailable').hide();
            }

            return false;
        });

        $('#add-to-cart').click(function(e) {
            e.preventDefault();

            var addButton = $(this);

            var quantity = $('#quantity').val();

            console.log($('#quantity').cleanVal());

            if($('#quantity').hasClass('flexy-weight-mask')) {
                quantity = $('#quantity').unmask().mask('#######0.000').val();
            }

            var variantId = $('#variantSelect').val();

            $.ajax({
                url: '{{ path('flexy_ftwo_store_cart_add') }}',
                type: 'post',
                dataType: 'json',
                data: {
                    id: variantId,
                    quantity: quantity
                },
                beforeSend: function () {
                    if (isNaN(quantity) || isNaN(variantId)) {
                        alert('Problemas ao inserir no carrinho...');
                        window.location.reload();
                    }

                    addButton.html("<i class='fa fa-plus'></i> Carregando...");
                },
                success: function (data) {
                    addButton.html("<i class='fa fa-plus'></i> Adicionar ao carrinho via Ajax");
                    updateCartInformation(data.cart);
                },
                error: function (data) {
                    var message = $.parseJSON(data.responseText);
                    alert(message.error);
                    window.location.reload();
                }
            });
        });

        function updateCartInformation(cart) {
            var miniCart = "<i class='fa fa-shopping-cart'></i> Carrinho ({CART_QTY}) R$ {CART_TOTAL}";
            miniCart = miniCart.replace('{CART_QTY}', cart.itemsCount);
            miniCart = miniCart.replace('{CART_TOTAL}', number_format(new Number(cart.totalWithDiscount), 2, ',', '.'));

            $('#minicart').fadeOut(400, function(){
                $(this).fadeIn(400);
                $(this).html(miniCart);
            });
        };

        /**
         * @see https://raw.githubusercontent.com/kvz/phpjs/master/functions/strings/number_format.js
         */
        function number_format(number, decimals, dec_point, thousands_sep) {
            number = (number + '')
                    .replace(/[^0-9+\-Ee.]/g, '');
            var n = !isFinite(+number) ? 0 : +number,
                    prec = !isFinite(+decimals) ? 0 : Math.abs(decimals),
                    sep = (typeof thousands_sep === 'undefined') ? ',' : thousands_sep,
                    dec = (typeof dec_point === 'undefined') ? '.' : dec_point,
                    s = '',
                    toFixedFix = function (n, prec) {
                        var k = Math.pow(10, prec);
                        return '' + (Math.round(n * k) / k)
                                .toFixed(prec);
                    };
            // Fix for IE parseFloat(0.55).toFixed(0) = 0;
            s = (prec ? toFixedFix(n, prec) : '' + Math.round(n))
                    .split('.');
            if (s[0].length > 3) {
                s[0] = s[0].replace(/\B(?=(?:\d{3})+(?!\d))/g, sep);
            }
            if ((s[1] || '')
                    .length < prec) {
                s[1] = s[1] || '';
                s[1] += new Array(prec - s[1].length + 1)
                        .join('0');
            }
            return s.join(dec);
        }

        /**
         * Show quantity when select master variant
         *
         * @autor Eduardo Parucker
         */
        $('#variantSelect').change( function (e) {
        });

        /**
         * Change quantity from form
         */
        $('#quantity').change( function () {
            $('#cartQuantity').val($(this).val());
        });
    })(jQuery);
</script>
