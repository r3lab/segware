{# ADD TO CART - CUSTOM #}
<script>
    document.addEventListener("DOMContentLoaded", function () {

        $.ajax({
            url: "/checkout/current-cart",
            method: "GET",
            xhrFields: { withCredentials: true },

            success: function (data) {

                let totalQuantity = 0;

                if (data && Array.isArray(data.sales)) {
                    data.sales.forEach(function (sale) {
                        sale.items.forEach(function (item) {
                            totalQuantity += item.quantity || 0;
                        });
                    });
                }

                document.querySelectorAll(
                    ".cart-items-count, .cart-quantity-badge, .mini-cart-count"
                ).forEach(el=>{
                    el.textContent = totalQuantity;
                });

            }

        });

    });
</script>

<script>
(function () {

    let cartRequest = null;

    /* -------------------------
    LOADER BOTÃO
    ------------------------- */

    function disableBtn(btn, state) {

        btn.disabled = state;
        btn.classList.toggle('is-loading', state);

    }

    /* -------------------------
    PEGAR QTD MINICART
    ------------------------- */

    function getMiniCartCount() {

        const el = document.querySelector('.cart-items-count');

        if (!el) return 0;

        return parseFloat(el.textContent.trim()) || 0;

    }

    /* -------------------------
    ATUALIZAR MINICART
    ------------------------- */

    function updateMiniCart(addedQty) {

        const els = document.querySelectorAll(
            '.cart-items-count, .cart-quantity-badge, .mini-cart-count'
        );

        const current = getMiniCartCount();
        const total = current + addedQty;

        els.forEach(el => {
            el.textContent = total;
        });

    }

    /* -------------------------
    SUCESSO
    ------------------------- */

    function showSuccess(previousQty, addedQty) {

        if (typeof Swal === 'undefined') return;

        const newQty = previousQty + addedQty;

        let html;

        if (previousQty > 0) {

            html =
                '<div class="alert-quantity">' +
                    '<span class="title">Quantidade atualizada no carrinho.</span>' +
                    'Já havia: <b>' + previousQty + '</b><br>' +
                    'Adicionado agora: <b>+' + addedQty + '</b><br>' +
                    '<span class="total">Total atual: <b>' + newQty + '</b></span>' +
                '</div>';

        } else {

            html =
                'Produto adicionado ao carrinho.<br><br>' +
                'Quantidade: <b>' + addedQty + '</b>';

        }

        Swal.fire({
            html: html,
            showCancelButton: true,
            showCloseButton: true,
            confirmButtonText: 'Finalizar compra',
            cancelButtonText: 'Continuar comprando'
        }).then(r => {

            if (r.isConfirmed) {
                window.location = '/cart';
            }

        });

    }

    /* -------------------------
    ERRO
    ------------------------- */

    function showError(msg) {

        if (typeof Swal !== 'undefined') {

            Swal.fire({
                title: 'Produto não adicionado',
                html: msg || 'Erro ao adicionar produto'
            });

        } else {

            alert(msg);

        }

    }

    /* -------------------------
    NORMALIZA INPUT
    aceita vírgula
    ------------------------- */

    document.addEventListener('input', function (e) {

        if (!e.target.matches('.product-quantity'))
            return;

        e.target.value = e.target.value.replace(/,/g, '.');

    });

    /* -------------------------
    CLIQUE BOTÃO
    ------------------------- */

    document.addEventListener('click', function (e) {

        const btn = e.target.closest('.flexy-add-to-cart-custom');

        if (!btn) return;

        e.preventDefault();

        if (cartRequest) {

            console.warn('Add to cart em andamento');
            return;

        }

        const variantId = btn.dataset.variantId;
        const dc = btn.dataset.distributioncenter;

        /* ----------------------------------
        PEGA O CARD/PDP CORRETO
        ---------------------------------- */

        const container =
            btn.closest('.product') ||
            btn.closest('.product-details') ||
            btn.closest('.buy-box') ||
            document;

        /* ----------------------------------
        PEGA INPUT DA QTD
        ---------------------------------- */

        const qtyInput = container.querySelector(
            '.product-quantity'
        );

        /* ----------------------------------
        SUPORTE FRACIONADO
        ---------------------------------- */

        const quantity = parseFloat(
            qtyInput?.value?.replace(',', '.')
        ) || 1;

        const previousMiniCartQty =
            getMiniCartCount();

        let payload = {
            id: variantId,
            quantity: quantity
        };

        if (dc) {
            payload.distributionCenter = dc;
        }

        /* ----------------------------------
        CAMPOS ADICIONAIS DA PDP
        ---------------------------------- */

        const productDetails = document.querySelector(
            '.product-details'
        );

        if (productDetails) {

            const attributeFields = productDetails.querySelectorAll(
                '[name^="attributeValues["]'
            );

            let firstInvalidField = null;

            attributeFields.forEach(function (field) {

                if (field.disabled) {
                    return;
                }

                /*
                VALIDA CAMPOS OBRIGATÓRIOS
                */
                if (field.required) {

                    let isValid = true;

                    /*
                    Campo de imagem/arquivo
                    */
                    if (field.type === 'file') {

                        isValid =
                            field.files &&
                            field.files.length > 0;

                    }

                    /*
                    Checkbox e radio
                    */
                    else if (
                        field.type === 'checkbox' ||
                        field.type === 'radio'
                    ) {

                        isValid = field.checked;

                    }

                    /*
                    Input, textarea e select
                    */
                    else {

                        isValid =
                            field.value &&
                            field.value.trim() !== '';

                    }

                    if (!isValid) {

                        if (!firstInvalidField) {
                            firstInvalidField = field;
                        }

                        return;
                    }

                }

                /*
                CHECKBOX E RADIO:
                ENVIA SOMENTE SE MARCADO
                */
                if (
                    (field.type === 'checkbox' ||
                     field.type === 'radio') &&
                    !field.checked
                ) {
                    return;
                }

                /*
                CAMPO FILE / IMAGEM
                */
                if (field.type === 'file') {

                    if (
                        field.files &&
                        field.files.length
                    ) {
                        payload[field.name] =
                            field.files[0];
                    }

                    return;
                }

                /*
                INPUT, TEXTAREA E SELECT
                */
                payload[field.name] =
                    field.value;

            });

            /*
            EXISTE CAMPO OBRIGATÓRIO INVÁLIDO?
            INTERROMPE TOTALMENTE O ADD TO CART
            */
            if (firstInvalidField) {

                firstInvalidField.focus();

                /*
                Exibe mensagem padrão
                do navegador
                */
                if (
                    typeof firstInvalidField.reportValidity ===
                    'function'
                ) {
                    firstInvalidField.reportValidity();
                }

                return;
            }

        }
        
        disableBtn(btn, true);

        cartRequest = $.ajax({

            url: '/cart/add',
            type: 'POST',
            dataType: 'json',
            data: payload,

            success(res) {

                /* ERRO FLEXY */

                if (res.success === false) {

                    showError(res.error);
                    return;

                }

                /* SUCESSO */

                updateMiniCart(quantity);

                showSuccess(
                    previousMiniCartQty,
                    quantity
                );

            },

            error(xhr) {

                let msg =
                    'Erro ao adicionar produto';

                try {

                    const json =
                        JSON.parse(xhr.responseText);

                    if (json.error) {
                        msg = json.error;
                    }

                } catch (e) {}

                showError(msg);

            },

            complete() {

                cartRequest = null;
                disableBtn(btn, false);

            }

        });

    });

})();
</script>

{# Add To Cart Aditional #}
<script>
(function () {

    $('body').on(
        'cart-success',
        '.additional-to-cart',
        function (e, cart) {

            if (
                typeof Swal ===
                'undefined'
            ) {
                return;
            }

            Swal.fire({

                title:
                    'Produto adicionado',

                html:
                    'O produto foi adicionado ao carrinho.',

                showCancelButton:
                    true,

                showCloseButton:
                    true,

                confirmButtonText:
                    'Finalizar compra',

                cancelButtonText:
                    'Continuar comprando'

            }).then(result => {

                if (
                    result.isConfirmed
                ) {

                    window.location =
                        '/cart';

                }

            });

        }
    );

    $('body').on(
        'cart-error',
        function (
            e,
            error
        ) {

            if (
                typeof Swal ===
                'undefined'
            ) {
                return;
            }

            Swal.fire({

                icon:
                    'warning',

                title:
                    'Não foi possível adicionar',

                html:
                    error ||
                    'Erro ao adicionar produto'

            });

        }
    );

})();
</script>

<script>
    (function(){

        function syncMiniCart(){

            $.ajax({

                url:'/checkout/current-cart',
                method:'GET',
                xhrFields:{ withCredentials:true },

                success:function(data){

                    let total = 0;

                    if(data && Array.isArray(data.sales)){

                        data.sales.forEach(function(sale){

                            if(Array.isArray(sale.items)){

                                sale.items.forEach(function(item){

                                    total += item.quantity || 0;

                                });

                            }

                        });

                    }

                    document.querySelectorAll(
                        '.cart-items-count, .cart-quantity-badge, .mini-cart-count'
                    ).forEach(el=>{
                        el.textContent = total;
                    });

                }

            });

        }

        /* sincroniza quando muda de aba */
        document.addEventListener("visibilitychange",function(){

            if(!document.hidden){
                syncMiniCart();
            }

        });

        /* sincroniza quando volta foco da janela */
        window.addEventListener("focus",function(){
            syncMiniCart();
        });

    })();
</script>

