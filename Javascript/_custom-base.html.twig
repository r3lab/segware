<script>
   $(document).ready(function () {
      $.ajax({
         url: "/checkout/current-cart",
         method: "GET",
         xhrFields: {
            withCredentials: true
         },
         success: function (data) {
            let totalQuantity = 0;

            if (data && Array.isArray(data.sales)) {
               data.sales.forEach(function (sale) {
                  if (Array.isArray(sale.items)) {
                  sale.items.forEach(function (item) {
                     totalQuantity += item.quantity || 0;
                  });
                  }
               });
            }

            const label = totalQuantity === 1 ? "item" : "itens";
            $(".cart-items-count").html(totalQuantity + ' <span class="hidden-sm hidden-xs display-ruby">' + label + '</span>');
         },
         error: function (xhr, status, error) {
         console.error("Erro ao buscar o carrinho:", error);
         }
      });

      $('#selectShoppingStores').change(
         function (e) {
            e.preventDefault();

            window.location = '?shoppingStoreReferenceCode=' + $(this).val();
         }
      );

      $("#selectCustomerProfile").on('change', function() {
         $.ajax({
            url : '{{ path('flexy_ftwo_store_user_customer_choose') }}',
            data : {
               customerId : $(this).val()
            },
            success : function() {
               window.location.reload();
            },
            error : function() {
               alert("{{ 'store.customerSelectError'|trans }}");
            }
         });
      });

      $("a.remake-order").click(function (event) {
         if ($(this).hasClass("disabled")) {
            event.preventDefault()
            return
         }

         $(this).addClass("disabled")
      });

      $("#selectCustomerProfile").select2({
         placeholder: ' - selecione um cliente -',
         width: 'resolve',
         allowClear: false,
         theme: 'bootstrap',
         minimumResultsForSearch: 5
      });
   });
</script>

