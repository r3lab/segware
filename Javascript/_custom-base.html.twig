{# Menu mobile #}
<script>
    //Controla exibição do menu de navegação mobile 
    $(function(){
        $('a.open-menu, .sidenav .bg-menu-principal').on('click', function(event){
            event.preventDefault();
            $('a.open-menu, .sidenav .menu-principal, .sidenav .bg-menu-principal').toggleClass('active');
            if($('a.open-menu').hasClass('active')){
                $('a.open-menu i').removeClass('fa-bars').addClass('fa-times');
            }else{
                $('a.open-menu i').removeClass('fa-times').addClass('fa-bars');
            }
        });
    });

    $(function(){
        $('.sidenav ul.menu-principal li a.sub-menu').on('click', function(event){
            event.preventDefault();
            var count = 0;
            var $parentLi = $(this).closest('li');

            if($parentLi.find('div.drop-down-level-1').hasClass('active')){
                count++;
            }

            // Fecha todos os dropdowns antes de abrir um novo
            $('div.drop-down-level-1, ul.drop-down-level-2').removeClass('active');
            $('.sidenav ul.menu-principal li a.sub-menu i, .sidenav ul.menu-principal li a.sub-menu-2 i')
                .css('transform', 'rotate(0deg)')
                .removeClass("fa-angle-up")
                .addClass("fa-angle-down");

            if(count === 0){
                // Abre o primeiro nível do dropdown
                $parentLi.find('div.drop-down-level-1').addClass('active');
                $(this).find('i').css('transform', 'rotate(180deg)').removeClass("fa-angle-down").addClass("fa-angle-up");
            }
        });

        // Evento para abrir o segundo nível do dropdown
        $('.sidenav ul.menu-principal').on('click', 'a.sub-menu-2', function(event){
            event.preventDefault();
            var count = 0;
            var $parentLi = $(this).closest('li');

            if($parentLi.find('ul.drop-down-level-2').hasClass('active')){
                count++;
            }

            // Fecha todos os segundos níveis antes de abrir um novo
            $('ul.drop-down-level-2').removeClass('active');
            $('.sidenav ul.menu-principal li a.sub-menu-2 i')
                .css('transform', 'rotate(0deg)')
                .removeClass("fa-angle-right")
                .addClass("fa-angle-down");

            if(count === 0){
                // Abre o segundo nível do dropdown
                $parentLi.find('ul.drop-down-level-2').addClass('active');
                $(this).find('i').css('transform', 'rotate(90deg)').removeClass("fa-angle-down").addClass("fa-angle-right");
            }
        });
    });

