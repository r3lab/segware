<div class="form-group" xmlns="http://www.w3.org/1999/html">
    <label class="form-label">Nome da loja<span class="text-error">*</span></label>
    <div class="controls">
        <input type="text" class="form-control" required="required" name="tradingName" id="tradingName" value="{{ app.request.get('tradingName', store.name) }}">
    </div>
</div>

<div class="form-group">
    <label class="form-label">CNPJ<span class="text-error">*</span></label>
    <div class="controls">
        <input type="text" class="form-control flexy-input-cnpj" required name="cnpj" id="cnpj" value="{{ app.request.get('cnpj', store.cnpj) }}">
    </div>
</div>

<div class="form-group">
    <label class="form-label">Razão Social</label>
    <div class="controls">
        <input type="text" class="form-control" name="companyName" id="companyName" value="{{ app.request.get('companyName', store.name) }}">
    </div>
</div>

<div class="form-group">
    <label class="form-label">{{ 'generic.email.label'|trans }}<span class="text-error">*</span></label>
    <div class="controls">
        <input type="email" class="form-control" required="required" name="email" id="email" value="{{ app.request.get('email', store.email) }}">
    </div>
</div>

<div class="form-group">
    <label class="form-label">{{ 'generic.primaryPhone.label'|trans }}<span class="text-error">*</span></label>
    <div class="controls">
        <input type="text" class="form-control flexy-input-phone" required="required" name="primaryPhone" id="primaryPhone" value="{{ app.request.get('primaryPhone', store.primaryPhone) }}">
    </div>
</div>

{% if not fullForm %}
<div class="form-group">
    <label class="form-label">{{ 'admin.customer.form.responsible.label'|trans }}<span class="text-error">*</span></label>
    <div class="controls">
        <input type="text" class="form-control " required="required" name="responsible" id="responsible" value="{{ app.request.get('responsible', store.responsible) }}">
    </div>
</div>
{% endif %}


<div class="form-group">
    <div>
        <label class="form-label">
            {{ 'admin.shoppingStore.edit.logo'|trans }}
        </label>
    </div>

    <div class="controls image-logo">
        <input type="file" accept="image/*" name="logo" alt="logo" class="form-control" id="store-creation-logo-uploader" />
        <button class="clear-button"><i class="fa fa-lg fa-trash-o"></i>Limpar</button>
    </div>

    <img class="img-thumbnail logo-help" alt="Preview do Logo" id="store-creation-image-preview" />
</div>


<div class="form-group">
    <label class="form-label"> URL de acesso<span class="text-error">*</span></label>
    <div class="controls url-loja">
        <span class="text-left "> {{ app.request.uriForPath('/loja/') }}</span>
        <span class="text-right"> <input type="text" class="form-control flexy-input-code" required="required" name="referenceCode" id="referenceCode" value="{{ app.request.get('referenceCode', store.referenceCode) }}"></span>
    </div>
</div>

<script>
    const storeLogoPreview = document.querySelector('#store-creation-image-preview');
    const storeLogoUploader = document.querySelector('#store-creation-logo-uploader');

    storeLogoPreview.style.display = 'none';

    storeLogoUploader.onchange = function(e) {
        if ((this.files[0].size/1024 > 512)) {
            clearLogo();
            return alert('O tamanho máximo permitido para o logotipo é 500kb');
        }
        storeLogoPreview.src = window.URL.createObjectURL(this.files[0]);
        storeLogoPreview.style.display = 'block';
    }

    document.querySelector('.clear-button').onclick = function(e) {
        e.preventDefault();
        clearLogo();
    }

    function clearLogo() {
        storeLogoPreview.style.display = 'none';
        storeLogoPreview.src = '';
        storeLogoUploader.value = '';
    }
</script>